<Project>
  <PropertyGroup>
    <!-- Compiler warnings (nullability, unused parameters…) fail the build, so new ones get fixed
         when they're written instead of piling up. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet security advisories stay warnings: one published overnight shouldn't block an
         urgent deploy. List them with "dotnet list package" plus the vulnerable and include-transitive flags. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
