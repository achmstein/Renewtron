@page "/admin"

@using Renewtron.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext

<PageTitle>Admin Dashboard</PageTitle>

<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Admin Dashboard</h1>
            <p class="mt-2 text-sm text-gray-600">Monitor search activity and renewal requests</p>
        </div>

        <!-- Stats Cards -->
        <div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <div class="overflow-hidden rounded-lg bg-white shadow">
                <div class="px-4 py-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                            </svg>
                        </div>
                        <div class="ml-4 w-0 flex-1">
                            <dt class="truncate text-sm font-medium text-gray-500">Total Searches</dt>
                            <dd class="mt-1 text-2xl font-semibold text-gray-900">@stats.TotalSearches</dd>
                        </div>
                    </div>
                </div>
            </div>

            <div class="overflow-hidden rounded-lg bg-white shadow">
                <div class="px-4 py-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="ml-4 w-0 flex-1">
                            <dt class="truncate text-sm font-medium text-gray-500">Successful</dt>
                            <dd class="mt-1 text-2xl font-semibold text-gray-900">@stats.SuccessfulSearches</dd>
                        </div>
                    </div>
                </div>
            </div>

            <div class="overflow-hidden rounded-lg bg-white shadow">
                <div class="px-4 py-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                            </svg>
                        </div>
                        <div class="ml-4 w-0 flex-1">
                            <dt class="truncate text-sm font-medium text-gray-500">Renewals Initiated</dt>
                            <dd class="mt-1 text-2xl font-semibold text-gray-900">@stats.RenewalsInitiated</dd>
                        </div>
                    </div>
                </div>
            </div>

            <div class="overflow-hidden rounded-lg bg-white shadow">
                <div class="px-4 py-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
                            </svg>
                        </div>
                        <div class="ml-4 w-0 flex-1">
                            <dt class="truncate text-sm font-medium text-gray-500">Renewals Completed</dt>
                            <dd class="mt-1 text-2xl font-semibold text-gray-900">@stats.RenewalsCompleted</dd>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="mb-6">
            <div class="border-b border-gray-200">
                <nav class="-mb-px flex space-x-8">
                    <button @onclick="() => activeTab = Tab.Searches"
                            class="@(activeTab == Tab.Searches ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700") whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium">
                        Recent Searches
                    </button>
                    <button @onclick="() => activeTab = Tab.Renewals"
                            class="@(activeTab == Tab.Renewals ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700") whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium">
                        Renewal Requests
                    </button>
                    <button @onclick="() => activeTab = Tab.CreditCards"
                            class="@(activeTab == Tab.CreditCards ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700") whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium">
                        Saved Credit Cards
                    </button>
                </nav>
            </div>
        </div>

        @if (activeTab == Tab.Searches)
        {
            <!-- Recent Searches Table -->
            <div class="overflow-hidden rounded-lg bg-white shadow">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Recent Searches</h3>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Date/Time</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">ABN</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">IP Address</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Results</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white">
                                @foreach (var search in recentSearches)
                                {
                                    <tr>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">
                                            @search.SearchedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                        </td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">@search.Abn</td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">@search.IpAddress</td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">@search.ResultsCount</td>
                                        <td class="whitespace-nowrap px-6 py-4">
                                            @if (search.Success)
                                            {
                                                <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Success</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Failed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (activeTab == Tab.Renewals)
        {
            <!-- Renewal Requests Table -->
            <div class="overflow-hidden rounded-lg bg-white shadow">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Renewal Requests</h3>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Date/Time</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Business Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Years</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Email</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Transaction Ref</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white">
                                @foreach (var renewal in renewalRequests)
                                {
                                    <tr>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">
                                            @renewal.InitiatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                        </td>
                                        <td class="px-6 py-4 text-sm font-medium text-gray-900">
                                            @renewal.SearchResult?.BusinessName
                                        </td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">@renewal.RenewalYears</td>
                                        <td class="px-6 py-4 text-sm text-gray-500">@renewal.Email</td>
                                        <td class="whitespace-nowrap px-6 py-4">
                                            @if (renewal.Completed)
                                            {
                                                <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex rounded-full bg-yellow-100 px-2 text-xs font-semibold leading-5 text-yellow-800">Pending</span>
                                            }
                                        </td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                                            @(renewal.TransactionReference ?? "N/A")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Saved Credit Cards Table -->
            <div class="overflow-hidden rounded-lg bg-white shadow">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Saved Credit Cards</h3>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Date Saved</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Cardholder</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Card</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Expiry</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">IP Address</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white">
                                @foreach (var card in savedCreditCards)
                                {
                                    <tr>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">
                                            @card.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                        </td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                                            @card.CardholderName
                                        </td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                                            @card.CardBrand •••• @card.CardNumberLast4
                                        </td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                                            @card.ExpiryMonth/@card.ExpiryYear
                                        </td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">@card.IpAddress</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private enum Tab { Searches, Renewals, CreditCards }

    private Tab activeTab = Tab.Searches;
    private List<SearchLog> recentSearches = new();
    private List<RenewalRequest> renewalRequests = new();
    private List<SavedCreditCard> savedCreditCards = new();

    private DashboardStats stats = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        // Load stats
        stats.TotalSearches = await DbContext.SearchLogs.CountAsync();
        stats.SuccessfulSearches = await DbContext.SearchLogs.CountAsync(s => s.Success);
        stats.RenewalsInitiated = await DbContext.RenewalRequests.CountAsync();
        stats.RenewalsCompleted = await DbContext.RenewalRequests.CountAsync(r => r.Completed);

        // Load recent searches
        recentSearches = await DbContext.SearchLogs
            .OrderByDescending(s => s.SearchedAt)
            .Take(50)
            .ToListAsync();

        // Load renewal requests
        renewalRequests = await DbContext.RenewalRequests
            .Include(r => r.SearchResult)
            .OrderByDescending(r => r.InitiatedAt)
            .Take(50)
            .ToListAsync();

        // Load saved credit cards
        savedCreditCards = await DbContext.SavedCreditCards
            .OrderByDescending(c => c.CreatedAt)
            .Take(50)
            .ToListAsync();
    }

    private class DashboardStats
    {
        public int TotalSearches { get; set; }
        public int SuccessfulSearches { get; set; }
        public int RenewalsInitiated { get; set; }
        public int RenewalsCompleted { get; set; }
    }
}