@page "/admin/leads"

@using Renewtron.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext

<PageTitle>Leads - Admin</PageTitle>

<header class="relative bg-white shadow-sm">
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
            <h1 class="text-lg/6 font-semibold text-gray-900">Leads</h1>
            <div class="flex items-center gap-4 text-sm text-gray-500">
                <span><span class="font-medium text-gray-900">@totalCount</span> total</span>
                <span class="text-gray-300">|</span>
                <span class="text-green-600"><span class="font-medium">@convertedCount</span> converted</span>
                <span class="text-gray-300">|</span>
                <span class="text-amber-600"><span class="font-medium">@notDueCount</span> not due</span>
                <span class="text-gray-300">|</span>
                <span class="text-blue-600"><span class="font-medium">@reminderCount</span> reminders</span>
            </div>
        </div>
    </div>
</header>

<main>
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <!-- Filters -->
        <div class="mb-6 flex flex-wrap items-end gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Outcome</label>
                <select @bind="outcomeFilter" @bind:after="LoadData" class="rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm">
                    <option value="">All Outcomes</option>
                    <option value="RenewalCompleted">Converted</option>
                    <option value="RenewalAvailable">Available</option>
                    <option value="NotDueForRenewal">Not Due</option>
                    <option value="RenewalInProgress">In Progress</option>
                    <option value="NoBusinessNames">No Names</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Reminder</label>
                <select @bind="reminderFilter" @bind:after="LoadData" class="rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm">
                    <option value="">All</option>
                    <option value="true">Opted In</option>
                    <option value="false">Not Opted In</option>
                </select>
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-medium text-gray-700 mb-1">Search</label>
                <input type="text" @bind="searchTerm" @bind:event="oninput" @bind:after="LoadData" placeholder="ABN, name, or email..."
                       class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" />
            </div>
        </div>

        <!-- Leads Table -->
        <div class="overflow-hidden rounded-lg bg-white shadow">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Lead</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">ABN</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Outcome</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Reminder</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Created</th>
                        <th scope="col" class="relative px-6 py-3">
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    @if (!leads.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-sm text-gray-500">
                                No leads found
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var lead in leads)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 h-10 w-10">
                                            <div class="h-10 w-10 rounded-full bg-gray-200 flex items-center justify-center">
                                                <span class="text-sm font-medium text-gray-600">@GetInitials(lead.FullName)</span>
                                            </div>
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-medium text-gray-900">@lead.FullName</div>
                                            <div class="text-sm text-gray-500">@lead.Email</div>
                                            <div class="text-xs text-gray-400">@lead.MobileNumber</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900 font-mono">@FormatAbn(lead.Abn)</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @switch (lead.Outcome)
                                    {
                                        case LeadOutcome.RenewalCompleted:
                                            <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">
                                                Converted
                                            </span>
                                            break;
                                        case LeadOutcome.RenewalAvailable:
                                            <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">
                                                Available
                                            </span>
                                            break;
                                        case LeadOutcome.NotDueForRenewal:
                                            <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">
                                                Not Due
                                            </span>
                                            break;
                                        case LeadOutcome.RenewalInProgress:
                                            <span class="inline-flex items-center rounded-full bg-purple-100 px-2.5 py-0.5 text-xs font-medium text-purple-800">
                                                In Progress
                                            </span>
                                            break;
                                        case LeadOutcome.NoBusinessNames:
                                            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">
                                                No Names
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600">
                                                Pending
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (lead.ReminderOptIn)
                                    {
                                        <span class="inline-flex items-center text-green-600">
                                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                            </svg>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">-</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <div>@lead.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    <div class="text-xs text-gray-400">@lead.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a href="/admin/leads/@lead.Id" class="text-blue-600 hover:text-blue-900">View</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>

@code {
    private List<Lead> leads = new();
    private string outcomeFilter = "";
    private string reminderFilter = "";
    private string searchTerm = "";

    private int totalCount;
    private int convertedCount;
    private int notDueCount;
    private int reminderCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        // Load summary stats (always show totals regardless of filter)
        totalCount = await DbContext.Leads.CountAsync();
        convertedCount = await DbContext.Leads.CountAsync(l => l.Outcome == LeadOutcome.RenewalCompleted);
        notDueCount = await DbContext.Leads.CountAsync(l => l.Outcome == LeadOutcome.NotDueForRenewal);
        reminderCount = await DbContext.Leads.CountAsync(l => l.ReminderOptIn);

        // Build query
        var query = DbContext.Leads.AsQueryable();

        // Apply outcome filter
        if (!string.IsNullOrEmpty(outcomeFilter) && Enum.TryParse<LeadOutcome>(outcomeFilter, out var outcome))
        {
            query = query.Where(l => l.Outcome == outcome);
        }

        // Apply reminder filter
        if (!string.IsNullOrEmpty(reminderFilter))
        {
            var reminderValue = reminderFilter == "true";
            query = query.Where(l => l.ReminderOptIn == reminderValue);
        }

        // Apply search filter
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var term = searchTerm.ToLower();
            query = query.Where(l =>
                l.Abn.Contains(term) ||
                l.FullName.ToLower().Contains(term) ||
                l.Email.ToLower().Contains(term));
        }

        leads = await query
            .OrderByDescending(l => l.CreatedAt)
            .Take(100)
            .ToListAsync();
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        return name[..Math.Min(2, name.Length)].ToUpper();
    }

    private string FormatAbn(string abn)
    {
        var clean = abn.Replace(" ", "");
        if (clean.Length == 11)
            return $"{clean[..2]} {clean[2..5]} {clean[5..8]} {clean[8..]}";
        return abn;
    }
}
