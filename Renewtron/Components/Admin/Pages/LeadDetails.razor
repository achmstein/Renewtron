@page "/admin/leads/{id:guid}"

@using Renewtron.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Lead Details - Admin</PageTitle>

<header class="relative bg-white shadow-sm">
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
            <h1 class="text-lg/6 font-semibold text-gray-900">Lead Details</h1>
            <a href="/admin/leads" class="text-sm text-gray-600 hover:text-gray-900">
                ← Back to Leads
            </a>
        </div>
    </div>
</header>

<main>
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        @if (isLoading)
        {
            <div class="text-center py-12">
                <svg class="mx-auto h-12 w-12 animate-spin text-blue-600" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <p class="mt-4 text-sm text-gray-600">Loading...</p>
            </div>
        }
        else if (lead == null)
        {
            <div class="text-center py-12">
                <h3 class="text-lg font-semibold text-gray-900">Lead Not Found</h3>
                <p class="mt-2 text-sm text-gray-600">The lead you're looking for doesn't exist.</p>
            </div>
        }
        else
        {
            <!-- Status Overview -->
            <div class="mb-6 overflow-hidden rounded-lg bg-white shadow">
                <div class="px-6 py-5">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-2xl font-bold text-gray-900">@lead.FullName</h2>
                            <p class="mt-1 text-sm text-gray-500">ABN: @FormatAbn(lead.Abn)</p>
                        </div>
                        <div class="text-right flex flex-col items-end gap-2">
                            @switch (lead.Outcome)
                            {
                                case LeadOutcome.RenewalCompleted:
                                    <span class="inline-flex rounded-full bg-green-100 px-3 py-1 text-sm font-semibold leading-5 text-green-800">Converted</span>
                                    break;
                                case LeadOutcome.RenewalAvailable:
                                    <span class="inline-flex rounded-full bg-blue-100 px-3 py-1 text-sm font-semibold leading-5 text-blue-800">Available</span>
                                    break;
                                case LeadOutcome.NotDueForRenewal:
                                    <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold leading-5 text-amber-800">Not Due</span>
                                    break;
                                case LeadOutcome.RenewalInProgress:
                                    <span class="inline-flex rounded-full bg-purple-100 px-3 py-1 text-sm font-semibold leading-5 text-purple-800">In Progress</span>
                                    break;
                                case LeadOutcome.NoBusinessNames:
                                    <span class="inline-flex rounded-full bg-gray-100 px-3 py-1 text-sm font-semibold leading-5 text-gray-800">No Names</span>
                                    break;
                                default:
                                    <span class="inline-flex rounded-full bg-gray-100 px-3 py-1 text-sm font-semibold leading-5 text-gray-600">Pending</span>
                                    break;
                            }
                            @if (lead.ReminderOptIn)
                            {
                                <span class="inline-flex items-center gap-1 text-sm text-green-600">
                                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                    </svg>
                                    Reminder Opt-in
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                <!-- Contact Information -->
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
                        <h3 class="text-base font-semibold text-gray-900">Contact Information</h3>
                    </div>
                    <div class="px-6 py-4">
                        <dl class="space-y-4">
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Full Name</dt>
                                <dd class="mt-1 text-sm text-gray-900">@lead.FullName</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Email</dt>
                                <dd class="mt-1 text-sm text-gray-900">
                                    <a href="mailto:@lead.Email" class="text-blue-600 hover:text-blue-500">@lead.Email</a>
                                </dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Mobile Number</dt>
                                <dd class="mt-1 text-sm text-gray-900">
                                    <a href="tel:@lead.MobileNumber" class="text-blue-600 hover:text-blue-500">@lead.MobileNumber</a>
                                </dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Date of Birth</dt>
                                <dd class="mt-1 text-sm text-gray-900">@lead.DateOfBirth.ToString("dd/MM/yyyy")</dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <!-- Lead Information -->
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
                        <h3 class="text-base font-semibold text-gray-900">Lead Information</h3>
                    </div>
                    <div class="px-6 py-4">
                        <dl class="space-y-4">
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Lead ID</dt>
                                <dd class="mt-1 text-sm text-gray-900 font-mono text-xs">@lead.Id</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">ABN</dt>
                                <dd class="mt-1 text-sm text-gray-900 font-mono">@FormatAbn(lead.Abn)</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Created At</dt>
                                <dd class="mt-1 text-sm text-gray-900">@lead.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</dd>
                            </div>
                            @if (lead.ConvertedToRenewal && lead.ConvertedAt.HasValue)
                            {
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Converted At</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@lead.ConvertedAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</dd>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(lead.OutcomeMessage))
                            {
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Outcome Message</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@lead.OutcomeMessage</dd>
                                </div>
                            }
                        </dl>
                    </div>
                </div>

                <!-- Tracking Information -->
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
                        <h3 class="text-base font-semibold text-gray-900">Tracking Information</h3>
                    </div>
                    <div class="px-6 py-4">
                        <dl class="space-y-4">
                            <div>
                                <dt class="text-sm font-medium text-gray-500">IP Address</dt>
                                <dd class="mt-1 text-sm text-gray-900 font-mono">@(lead.IpAddress ?? "N/A")</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Session ID</dt>
                                <dd class="mt-1 text-sm text-gray-900 font-mono text-xs break-all">@(lead.SessionId ?? "N/A")</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">User Agent</dt>
                                <dd class="mt-1 text-sm text-gray-900 text-xs break-all">@(lead.UserAgent ?? "N/A")</dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <!-- Search Results -->
                @if (lead.SearchLog != null)
                {
                    <div class="overflow-hidden rounded-lg bg-white shadow">
                        <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
                            <h3 class="text-base font-semibold text-gray-900">ASIC Search Results</h3>
                        </div>
                        <div class="px-6 py-4">
                            <dl class="space-y-4">
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Search Date</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@lead.SearchLog.SearchedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Search Status</dt>
                                    <dd class="mt-1">
                                        @if (lead.SearchLog.Success)
                                        {
                                            <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Success</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Failed</span>
                                        }
                                    </dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Results Count</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@lead.SearchLog.ResultsCount business name(s)</dd>
                                </div>
                                @if (!string.IsNullOrEmpty(lead.SearchLog.ErrorMessage))
                                {
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Error Message</dt>
                                        <dd class="mt-1 text-sm text-red-600">@lead.SearchLog.ErrorMessage</dd>
                                    </div>
                                }
                            </dl>

                            @if (searchResults.Any())
                            {
                                <div class="mt-4 pt-4 border-t border-gray-200">
                                    <h4 class="text-sm font-medium text-gray-900 mb-3">Business Names Found</h4>
                                    <ul class="space-y-2">
                                        @foreach (var result in searchResults)
                                        {
                                            <li class="flex items-center justify-between rounded-md bg-gray-50 px-3 py-2">
                                                <div>
                                                    <span class="text-sm font-medium text-gray-900">@result.BusinessName</span>
                                                    <span class="ml-2 text-xs text-gray-500">(@result.AccountNumber)</span>
                                                </div>
                                                <span class="text-xs text-gray-500">Reg: @result.RegistrationDate</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Renewal Requests -->
            @if (lead.RenewalRequests.Any())
            {
                <div class="mt-6 overflow-hidden rounded-lg bg-white shadow">
                    <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
                        <h3 class="text-base font-semibold text-gray-900">Renewal Requests</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Business Name</th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Amount</th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Years</th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Initiated</th>
                                    <th scope="col" class="relative px-6 py-3">
                                        <span class="sr-only">View</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white">
                                @foreach (var renewal in lead.RenewalRequests)
                                {
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                            @(renewal.SearchResult?.BusinessName ?? "N/A")
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            @switch (renewal.Status)
                                            {
                                                case RenewalStatus.Completed:
                                                    <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Completed</span>
                                                    break;
                                                case RenewalStatus.Processing:
                                                    <span class="inline-flex rounded-full bg-blue-100 px-2 text-xs font-semibold leading-5 text-blue-800">Processing</span>
                                                    break;
                                                case RenewalStatus.Pending:
                                                    <span class="inline-flex rounded-full bg-yellow-100 px-2 text-xs font-semibold leading-5 text-yellow-800">Pending</span>
                                                    break;
                                                case RenewalStatus.Failed:
                                                    <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Failed</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                            $@renewal.Amount.ToString("F2")
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                            @renewal.RenewalYears yr
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            @renewal.InitiatedAt.ToLocalTime().ToString("MMM dd, HH:mm")
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            <a href="/admin/renewals/@renewal.Id" class="text-blue-600 hover:text-blue-900">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</main>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Lead? lead;
    private List<SearchResult> searchResults = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        lead = await DbContext.Leads
            .Include(l => l.SearchLog)
            .Include(l => l.RenewalRequests)
                .ThenInclude(r => r.SearchResult)
            .FirstOrDefaultAsync(l => l.Id == Id);

        if (lead?.SearchLogId != null)
        {
            searchResults = await DbContext.SearchResults
                .Where(sr => sr.SearchLogId == lead.SearchLogId)
                .ToListAsync();
        }

        isLoading = false;
    }

    private string FormatAbn(string abn)
    {
        var clean = abn.Replace(" ", "");
        if (clean.Length == 11)
            return $"{clean[..2]} {clean[2..5]} {clean[5..8]} {clean[8..]}";
        return abn;
    }
}
