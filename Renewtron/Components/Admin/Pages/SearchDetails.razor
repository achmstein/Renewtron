@page "/admin/searches/{id:guid}"

@using Renewtron.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Search Details - Admin</PageTitle>

<div class="min-h-full">
    <AdminNavMenu />

    <header class="relative bg-white shadow-sm">
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between">
                <h1 class="text-lg/6 font-semibold text-gray-900">Search Details</h1>
                <a href="/admin/renewals" class="text-sm text-gray-600 hover:text-gray-900">
                    ← Back to Searches
                </a>
            </div>
        </div>
    </header>

    <main>
        <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
            @if (isLoading)
            {
                <div class="flex items-center justify-center py-12">
                    <svg class="animate-spin h-8 w-8 text-indigo-600" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="ml-3 text-sm text-gray-600">Loading...</span>
                </div>
            }
            else if (searchLog == null)
            {
                <div class="rounded-lg bg-yellow-50 p-4">
                    <div class="flex">
                        <div class="shrink-0">
                            <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-yellow-800">Search not found</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Search Info Card -->
                <div class="mb-6 overflow-hidden rounded-lg bg-white shadow">
                    <div class="border-b border-gray-200 bg-gray-50 px-6 py-4">
                        <h2 class="text-lg font-medium text-gray-900">Search Information</h2>
                    </div>
                    <div class="px-6 py-5">
                        <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
                            <div>
                                <dt class="text-sm font-medium text-gray-500">ABN</dt>
                                <dd class="mt-1 text-sm font-semibold text-gray-900">@searchLog.Abn</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Searched At</dt>
                                <dd class="mt-1 text-sm text-gray-900">@searchLog.SearchedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">IP Address</dt>
                                <dd class="mt-1 text-sm text-gray-900">@searchLog.IpAddress</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Session ID</dt>
                                <dd class="mt-1 text-sm font-mono text-gray-900">@(searchLog.SessionId?.Substring(0, 13) ?? "N/A")</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Status</dt>
                                <dd class="mt-1">
                                    @if (searchLog.Success)
                                    {
                                        <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Success</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Failed</span>
                                    }
                                </dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Results Count</dt>
                                <dd class="mt-1 text-sm text-gray-900">@searchLog.ResultsCount business name(s)</dd>
                            </div>
                            @if (!string.IsNullOrEmpty(searchLog.ErrorMessage))
                            {
                                <div class="sm:col-span-3">
                                    <dt class="text-sm font-medium text-gray-500">Error Message</dt>
                                    <dd class="mt-1 text-sm text-red-600">@searchLog.ErrorMessage</dd>
                                </div>
                            }
                        </dl>
                    </div>
                </div>

                <!-- Business Names Found -->
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <div class="border-b border-gray-200 bg-gray-50 px-6 py-4">
                        <h2 class="text-lg font-medium text-gray-900">Business Names Found (@searchLog.Results.Count)</h2>
                    </div>
                    @if (searchLog.Results.Any())
                    {
                        <div class="divide-y divide-gray-200">
                            @foreach (var result in searchLog.Results)
                            {
                                <div class="px-6 py-5">
                                    <div class="flex items-start justify-between">
                                        <div class="flex-1">
                                            <h3 class="text-base font-semibold text-gray-900">@result.BusinessName</h3>
                                            <dl class="mt-4 grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
                                                <div>
                                                    <dt class="text-xs font-medium text-gray-500">Status</dt>
                                                    <dd class="mt-1">
                                                        @if (!string.IsNullOrEmpty(result.Status))
                                                        {
                                                            <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset @GetStatusClass(result.Status)">
                                                                @result.Status
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-xs text-gray-400">N/A</span>
                                                        }
                                                    </dd>
                                                </div>
                                                <div>
                                                    <dt class="text-xs font-medium text-gray-500">Registration Date</dt>
                                                    <dd class="mt-1 text-sm text-gray-900">@(result.RegistrationDate ?? "N/A")</dd>
                                                </div>
                                                <div>
                                                    <dt class="text-xs font-medium text-gray-500">Renewal Date</dt>
                                                    <dd class="mt-1 text-sm text-gray-900">@(result.RenewalDate ?? "N/A")</dd>
                                                </div>
                                                @if (!string.IsNullOrEmpty(result.CancelledDate))
                                                {
                                                    <div>
                                                        <dt class="text-xs font-medium text-gray-500">Cancelled Date</dt>
                                                        <dd class="mt-1 text-sm text-red-600">@result.CancelledDate</dd>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(result.AddressForServiceDocuments))
                                                {
                                                    <div class="sm:col-span-2 lg:col-span-3">
                                                        <dt class="text-xs font-medium text-gray-500">Address for Service Documents</dt>
                                                        <dd class="mt-1 text-sm text-gray-900">@result.AddressForServiceDocuments</dd>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(result.PrincipalPlaceOfBusiness))
                                                {
                                                    <div class="sm:col-span-2 lg:col-span-3">
                                                        <dt class="text-xs font-medium text-gray-500">Principal Place of Business</dt>
                                                        <dd class="mt-1 text-sm text-gray-900">@result.PrincipalPlaceOfBusiness</dd>
                                                    </div>
                                                }
                                            </dl>

                                            @if (result.Holders.Any())
                                            {
                                                <div class="mt-4">
                                                    <h4 class="text-sm font-medium text-gray-900 mb-2">Holders</h4>
                                                    <div class="space-y-2">
                                                        @foreach (var holder in result.Holders)
                                                        {
                                                            <div class="flex items-center rounded-md bg-gray-50 px-3 py-2">
                                                                <svg class="h-4 w-4 text-gray-400 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                                                                </svg>
                                                                <span class="text-sm text-gray-700">@holder.Name</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (result.RenewalRequest != null)
                                            {
                                                <div class="mt-4">
                                                    <h4 class="text-sm font-medium text-gray-900 mb-2">Renewal Request</h4>
                                                    <div class="space-y-2">
                                                        <div class="flex items-center justify-between rounded-md bg-gray-50 px-3 py-2">
                                                            <div class="flex items-center gap-3">
                                                                <div>
                                                                    @if (result.RenewalRequest.Completed)
                                                                    {
                                                                        <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Completed</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Failed</span>
                                                                    }
                                                                </div>
                                                                <div class="text-xs text-gray-600">
                                                                    <span>@result.RenewalRequest.InitiatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                                                                    <span class="mx-1">•</span>
                                                                    <span>@result.RenewalRequest.RenewalYears year@(result.RenewalRequest.RenewalYears > 1 ? "s" : "")</span>
                                                                    <span class="mx-1">•</span>
                                                                    <span>$@result.RenewalRequest.CustomerAmount.ToString("F2")</span>
                                                                </div>
                                                            </div>
                                                            <a href="/admin/renewals/@result.RenewalRequest.Id" class="text-indigo-600 hover:text-indigo-900 text-xs font-medium">
                                                                View Details →
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="px-6 py-12 text-center">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                            </svg>
                            <p class="mt-2 text-sm text-gray-500">No business names found in this search</p>
                        </div>
                    }
                </div>
            }
        </div>
    </main>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private SearchLog? searchLog;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSearchDetails();
    }

    private async Task LoadSearchDetails()
    {
        isLoading = true;

        searchLog = await DbContext.SearchLogs
            .Include(s => s.Results)
                .ThenInclude(r => r.Holders)
            .Include(s => s.Results)
                .ThenInclude(r => r.RenewalRequest)
            .FirstOrDefaultAsync(s => s.Id == Id);

        isLoading = false;
    }

    private string GetStatusClass(string? status)
    {
        return status?.ToLower() switch
        {
            "registered" => "bg-green-50 text-green-700 ring-green-600/20",
            "active" => "bg-green-50 text-green-700 ring-green-600/20",
            "cancelled" => "bg-red-50 text-red-700 ring-red-600/20",
            "expired" => "bg-yellow-50 text-yellow-800 ring-yellow-600/20",
            _ => "bg-gray-50 text-gray-600 ring-gray-500/10"
        };
    }
}
