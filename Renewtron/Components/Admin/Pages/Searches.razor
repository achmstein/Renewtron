@page "/admin/searches"

@using Renewtron.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Search Logs - Renewtron</PageTitle>

<header class="relative bg-white shadow-sm">
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
            <h1 class="text-lg/6 font-semibold text-gray-900">Search Logs</h1>
        </div>
    </header>

    <main>
        <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
            <!-- Header -->
            <div class="mb-6 rounded-lg bg-white shadow">
                <div class="px-4 py-5 sm:px-6 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-medium leading-6 text-gray-900">Search Logs</h3>
                        <p class="mt-1 text-sm text-gray-500">@totalCount total searches</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="inline-flex rounded-md shadow-sm" role="group">
                            <button @onclick="() => viewMode = ViewMode.Table" type="button" class="@(viewMode == ViewMode.Table ? "bg-blue-600 text-white" : "bg-white text-gray-700 hover:bg-gray-50") inline-flex items-center px-3 py-2 text-sm font-semibold ring-1 ring-inset ring-gray-300 rounded-l-md">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0112 18.375m9.75-12.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125m19.5 0v1.5c0 .621-.504 1.125-1.125 1.125M2.25 5.625v1.5c0 .621.504 1.125 1.125 1.125m0 0h17.25m-17.25 0h7.5c.621 0 1.125.504 1.125 1.125M3.375 8.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m17.25-3.75h-7.5c-.621 0-1.125.504-1.125 1.125m8.625-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M12 10.875v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125M13.125 12h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125M20.625 12c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5M12 14.625v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 14.625c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m0 1.5v-1.5m0 0c0-.621.504-1.125 1.125-1.125m0 0h7.5" />
                                </svg>
                            </button>
                            <button @onclick="() => viewMode = ViewMode.Cards" type="button" class="@(viewMode == ViewMode.Cards ? "bg-blue-600 text-white" : "bg-white text-gray-700 hover:bg-gray-50") inline-flex items-center px-3 py-2 text-sm font-semibold ring-1 ring-inset ring-gray-300 rounded-r-md">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                                </svg>
                            </button>
                        </div>

                        <!-- Filters Button -->
                        <div class="relative">
                            <button @onclick="ToggleFilterPopover" class="@(showFilterPopover ? "bg-gray-100" : "bg-white") inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                                <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                                </svg>
                                Filters @(HasActiveFilters() ? $"({GetActiveFilterCount()})" : "")
                            </button>

                            @if (showFilterPopover)
                            {
                                <!-- Backdrop to close on outside click -->
                                <div class="fixed inset-0 z-10" @onclick="CloseFilterPopover"></div>

                                <div class="absolute right-0 z-20 mt-2 w-80 origin-top-right rounded-md bg-white shadow ring-1 ring-gray-300 focus:outline-none">
                                    <div class="p-4">
                                        <h3 class="text-sm font-medium text-gray-900 mb-3">Filter Searches</h3>

                                        <div class="space-y-3">
                                            <!-- ABN Filter -->
                                            <div>
                                                <label class="block text-xs font-medium text-gray-700 mb-1">ABN</label>
                                                <input type="text" @bind="tempFilterAbn" placeholder="Search ABN" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm px-3 py-2" />
                                            </div>

                                            <!-- Status Filter -->
                                            <div>
                                                <label class="block text-xs font-medium text-gray-700 mb-1">Status</label>
                                                <select @bind="tempFilterSuccess" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm px-3 py-2">
                                                    <option value="">All</option>
                                                    <option value="true">Success</option>
                                                    <option value="false">Failed</option>
                                                </select>
                                            </div>

                                            <!-- Initiated By Filter -->
                                            <div>
                                                <label class="block text-xs font-medium text-gray-700 mb-1">Initiated By</label>
                                                <select @bind="tempFilterInitiatedBy" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm px-3 py-2">
                                                    <option value="">All</option>
                                                    <option value="@SearchInitiator.Customer">Customer</option>
                                                    <option value="@SearchInitiator.Admin">Admin</option>
                                                </select>
                                            </div>

                                            <!-- Date Range -->
                                            <div class="grid grid-cols-2 gap-2">
                                                <div>
                                                    <label class="block text-xs font-medium text-gray-700 mb-1">From Date</label>
                                                    <input type="date" @bind="tempFilterDateFrom" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm px-3 py-2" />
                                                </div>
                                                <div>
                                                    <label class="block text-xs font-medium text-gray-700 mb-1">To Date</label>
                                                    <input type="date" @bind="tempFilterDateTo" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm px-3 py-2" />
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Actions -->
                                        <div class="mt-4 flex gap-2">
                                            <button @onclick="ApplyFiltersAndClose" class="flex-1 inline-flex justify-center items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                                                Apply
                                            </button>
                                            <button @onclick="ClearFiltersAndClose" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                                                Clear
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Refresh -->
                        <button @onclick="LoadData" disabled="@isRefreshing" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                            @if (isRefreshing)
                            {
                                <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            }
                            else
                            {
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <!-- Active Filter Chips -->
                @if (HasActiveFilters())
                {
                    <div class="px-4 pb-4 sm:px-6 flex flex-wrap gap-2">
                        @if (!string.IsNullOrEmpty(filterAbn))
                        {
                            <span class="inline-flex items-center gap-x-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-700">
                                ABN: @filterAbn
                                <button @onclick="@(async () => { filterAbn = ""; await ApplyFilters(); })" type="button" class="group relative -mr-1 h-3.5 w-3.5 rounded-sm hover:bg-blue-200">
                                    <svg class="h-3.5 w-3.5 stroke-blue-600" fill="none" viewBox="0 0 8 8" stroke-width="1.5">
                                        <path stroke-linecap="round" d="M1 1l6 6m0-6L1 7" />
                                    </svg>
                                </button>
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(filterSuccess))
                        {
                            <span class="inline-flex items-center gap-x-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-700">
                                Status: @(filterSuccess == "true" ? "Success" : "Failed")
                                <button @onclick="@(async () => { filterSuccess = ""; await ApplyFilters(); })" type="button" class="group relative -mr-1 h-3.5 w-3.5 rounded-sm hover:bg-blue-200">
                                    <svg class="h-3.5 w-3.5 stroke-blue-600" fill="none" viewBox="0 0 8 8" stroke-width="1.5">
                                        <path stroke-linecap="round" d="M1 1l6 6m0-6L1 7" />
                                    </svg>
                                </button>
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(filterInitiatedBy))
                        {
                            <span class="inline-flex items-center gap-x-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-700">
                                Initiated By: @filterInitiatedBy
                                <button @onclick="@(async () => { filterInitiatedBy = ""; await ApplyFilters(); })" type="button" class="group relative -mr-1 h-3.5 w-3.5 rounded-sm hover:bg-blue-200">
                                    <svg class="h-3.5 w-3.5 stroke-blue-600" fill="none" viewBox="0 0 8 8" stroke-width="1.5">
                                        <path stroke-linecap="round" d="M1 1l6 6m0-6L1 7" />
                                    </svg>
                                </button>
                            </span>
                        }
                        @if (filterDateFrom.HasValue)
                        {
                            <span class="inline-flex items-center gap-x-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-700">
                                From: @filterDateFrom.Value.ToString("MMM dd, yyyy")
                                <button @onclick="@(async () => { filterDateFrom = null; await ApplyFilters(); })" type="button" class="group relative -mr-1 h-3.5 w-3.5 rounded-sm hover:bg-blue-200">
                                    <svg class="h-3.5 w-3.5 stroke-blue-600" fill="none" viewBox="0 0 8 8" stroke-width="1.5">
                                        <path stroke-linecap="round" d="M1 1l6 6m0-6L1 7" />
                                    </svg>
                                </button>
                            </span>
                        }
                        @if (filterDateTo.HasValue)
                        {
                            <span class="inline-flex items-center gap-x-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-700">
                                To: @filterDateTo.Value.ToString("MMM dd, yyyy")
                                <button @onclick="@(async () => { filterDateTo = null; await ApplyFilters(); })" type="button" class="group relative -mr-1 h-3.5 w-3.5 rounded-sm hover:bg-blue-200">
                                    <svg class="h-3.5 w-3.5 stroke-blue-600" fill="none" viewBox="0 0 8 8" stroke-width="1.5">
                                        <path stroke-linecap="round" d="M1 1l6 6m0-6L1 7" />
                                    </svg>
                                </button>
                            </span>
                        }
                        <button @onclick="ClearFilters" class="inline-flex items-center gap-x-1 rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 hover:bg-gray-200">
                            Clear all
                        </button>
                    </div>
                }
            </div>

            @if (viewMode == ViewMode.Cards)
            {
                <!-- Card Grid -->

                <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                    @foreach (var search in searches)
                    {
                        <div class="overflow-hidden rounded-lg bg-white shadow hover:shadow-lg transition-shadow @(search.Success ? "border-l-4 border-green-500" : "border-l-4 border-red-500")">
                            <div class="px-4 py-5 sm:p-6">
                                <!-- Header Row -->
                                <div class="flex items-start justify-between mb-4">
                                    <div class="flex-1">
                                        <h3 class="text-base font-semibold text-gray-900">ABN: @search.Abn</h3>
                                        <p class="text-sm text-gray-500 mt-1 font-mono text-xs">Session: @search.SessionId</p>
                                    </div>
                                    <div>
                                        @if (search.Success)
                                        {
                                            <span class="inline-flex rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-800">Success</span>
                                        }
                                        else
                                        {
                                            <div class="flex items-center gap-1.5">
                                                <span class="inline-flex rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-800">Failed</span>
                                                @if (!string.IsNullOrEmpty(search.ErrorMessage))
                                                {
                                                    <button @onclick="() => ShowErrorModal(search.ErrorMessage)"
                                                            class="inline-flex items-center justify-center h-6 w-6 rounded-full bg-red-100 text-red-600 hover:bg-red-200"
                                                            title="View error details">
                                                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Details Grid -->
                                <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
                                    <div>
                                        <dt class="text-gray-500">Date & Time</dt>
                                        <dd class="mt-1 font-medium text-gray-900">@search.SearchedAt.ToLocalTime().ToString("MMM dd, yyyy")</dd>
                                        <dd class="text-xs text-gray-500">@search.SearchedAt.ToLocalTime().ToString("HH:mm:ss")</dd>
                                    </div>
                                    <div>
                                        <dt class="text-gray-500">Results Count</dt>
                                        <dd class="mt-1 font-medium text-gray-900">@search.ResultsCount</dd>
                                    </div>
                                    <div>
                                        <dt class="text-gray-500">Initiated By</dt>
                                        <dd class="mt-1 text-gray-900">
                                            <span class="text-gray-900">@search.InitiatedBy.ToString()</span>
                                        </dd>
                                    </div>
                                    <div>
                                        <dt class="text-gray-500">IP Address</dt>
                                        <dd class="mt-1 text-gray-900">@search.IpAddress</dd>
                                    </div>
                                    <div>
                                        <dt class="text-gray-500">Has Renewal</dt>
                                        <dd class="mt-1 text-gray-900">
                                            @if (search.Results.Any(r => r.RenewalRequest != null))
                                            {
                                                <span class="inline-flex items-center gap-1 text-green-600 font-medium">
                                                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                                    </svg>
                                                    Yes
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-gray-500">No</span>
                                            }
                                        </dd>
                                    </div>
                                </dl>

                                <!-- Actions -->
                                <div class="mt-4 flex items-center justify-end gap-2 pt-4 border-t border-gray-200">
                                    <a href="/admin/searches/@search.Id"
                                       class="inline-flex items-center rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                                        <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Table View -->

                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">ABN</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Results</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Initiated By</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Has Renewal</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            @foreach (var search in searches)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-medium text-gray-900">@search.Abn</div>
                                        <div class="text-xs text-gray-500 font-mono">@search.SessionId</div>
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4">
                                        @if (search.Success)
                                        {
                                            <span class="inline-flex rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-800">Success</span>
                                        }
                                        else
                                        {
                                            <div class="flex items-center gap-1.5">
                                                <span class="inline-flex rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-800">Failed</span>
                                                @if (!string.IsNullOrEmpty(search.ErrorMessage))
                                                {
                                                    <button @onclick="() => ShowErrorModal(search.ErrorMessage)"
                                                            class="inline-flex items-center justify-center h-6 w-6 rounded-full bg-red-100 text-red-600 hover:bg-red-200"
                                                            title="View error details">
                                                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">@search.ResultsCount</td>
                                    <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">
                                        @if (search.InitiatedBy == SearchInitiator.Admin)
                                        {
                                            <span class="text-blue-600 font-medium">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-900">Customer</span>
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4 text-sm">
                                        @if (search.Results.Any(r => r.RenewalRequest != null))
                                        {
                                            <span class="inline-flex items-center gap-1 text-green-600 font-medium">
                                                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                                </svg>
                                                Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-500">No</span>
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                                        <div>@search.SearchedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        <div class="text-xs">@search.SearchedAt.ToLocalTime().ToString("HH:mm:ss")</div>
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4 text-sm">
                                        <a href="/admin/searches/@search.Id" class="inline-flex items-center text-blue-600 hover:text-blue-900">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Pagination -->
            <div class="mt-4 flex items-center justify-between border-t border-gray-200 pt-4">
                <div class="flex flex-1 justify-between sm:hidden">
                    <button @onclick="PreviousPage" disabled="@(currentPage == 1)" class="relative inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50">
                        Previous
                    </button>
                    <button @onclick="NextPage" disabled="@(currentPage* pageSize >= totalCount)" class="relative ml-3 inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50">
                        Next
                    </button>
                </div>
                <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Showing
                            <span class="font-medium">@((currentPage - 1) * pageSize + 1)</span>
                            to
                            <span class="font-medium">@Math.Min(currentPage * pageSize, totalCount)</span>
                            of
                            <span class="font-medium">@totalCount</span>
                            results
                        </p>
                    </div>
                    <div>
                        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm">
                            <button @onclick="PreviousPage" disabled="@(currentPage == 1)" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 disabled:opacity-50">
                                <span class="sr-only">Previous</span>
                                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300">
                                Page @currentPage of @((int)Math.Ceiling(totalCount / (double)pageSize))
                            </span>
                            <button @onclick="NextPage" disabled="@(currentPage* pageSize >= totalCount)" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 disabled:opacity-50">
                                <span class="sr-only">Next</span>
                                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </nav>
                    </div>
                </div>
            </div>

            <!-- Error Modal -->
            @if (showErrorModal)
            {
                <div class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
                    <div class="fixed inset-0 bg-gray-500 opacity-75 transition-opacity" @onclick="CloseErrorModal"></div>
                    <div class="fixed inset-0 z-10 overflow-y-auto">
                        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                            <div class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg sm:p-6">
                                <div class="sm:flex sm:items-start">
                                    <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                                        <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                                        </svg>
                                    </div>
                                    <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                                        <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">Search Error Details</h3>
                                        <div class="mt-2">
                                            <p class="text-sm text-gray-700">@currentErrorMessage</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
                                    <button @onclick="CloseErrorModal" type="button" class="inline-flex w-full justify-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 sm:ml-3 sm:w-auto">
                                        Close
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>

@code {
    private enum ViewMode { Cards, Table }

    private List<SearchLog> searches = new();
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private bool isRefreshing = false;
    private bool showErrorModal = false;
    private string currentErrorMessage = "";

    private ViewMode viewMode = ViewMode.Table;
    private bool showFilterPopover = false;

    // Temp filter variables (for popover)
    private string tempFilterAbn = "";
    private string tempFilterSuccess = "";
    private string tempFilterInitiatedBy = "";
    private DateTime? tempFilterDateFrom = null;
    private DateTime? tempFilterDateTo = null;

    // Actual filter variables (applied)
    private string filterAbn = "";
    private string filterSuccess = "";
    private string filterInitiatedBy = "";
    private DateTime? filterDateFrom = null;
    private DateTime? filterDateTo = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isRefreshing = true;

        try
        {
            var query = DbContext.SearchLogs
                .Include(s => s.Results)
                    .ThenInclude(r => r.RenewalRequest)
                .AsQueryable();

            // Apply filters
            if (!string.IsNullOrEmpty(filterAbn))
            {
                query = query.Where(s => s.Abn.Contains(filterAbn));
            }

            if (!string.IsNullOrEmpty(filterSuccess) && bool.TryParse(filterSuccess, out var success))
            {
                query = query.Where(s => s.Success == success);
            }

            if (!string.IsNullOrEmpty(filterInitiatedBy) && Enum.TryParse<SearchInitiator>(filterInitiatedBy, out var initiator))
            {
                query = query.Where(s => s.InitiatedBy == initiator);
            }

            if (filterDateFrom.HasValue)
            {
                query = query.Where(s => s.SearchedAt >= filterDateFrom.Value);
            }

            if (filterDateTo.HasValue)
            {
                var dateTo = filterDateTo.Value.AddDays(1); // Include the entire day
                query = query.Where(s => s.SearchedAt < dateTo);
            }

            totalCount = await query.CountAsync();

            searches = await query
                .OrderByDescending(s => s.SearchedAt)
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1; // Reset to first page when filters change
        await LoadData();
    }

    private async Task ClearFilters()
    {
        filterAbn = "";
        filterSuccess = "";
        filterInitiatedBy = "";
        filterDateFrom = null;
        filterDateTo = null;
        currentPage = 1;
        await LoadData();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrEmpty(filterAbn) ||
               !string.IsNullOrEmpty(filterSuccess) ||
               !string.IsNullOrEmpty(filterInitiatedBy) ||
               filterDateFrom.HasValue ||
               filterDateTo.HasValue;
    }

    private int GetActiveFilterCount()
    {
        int count = 0;
        if (!string.IsNullOrEmpty(filterAbn)) count++;
        if (!string.IsNullOrEmpty(filterSuccess)) count++;
        if (!string.IsNullOrEmpty(filterInitiatedBy)) count++;
        if (filterDateFrom.HasValue) count++;
        if (filterDateTo.HasValue) count++;
        return count;
    }

    private void ToggleFilterPopover()
    {
        if (showFilterPopover)
        {
            showFilterPopover = false;
        }
        else
        {
            // Initialize temp variables with current filter values
            tempFilterAbn = filterAbn;
            tempFilterSuccess = filterSuccess;
            tempFilterInitiatedBy = filterInitiatedBy;
            tempFilterDateFrom = filterDateFrom;
            tempFilterDateTo = filterDateTo;
            showFilterPopover = true;
        }
    }

    private void CloseFilterPopover()
    {
        showFilterPopover = false;
    }

    private async Task ApplyFiltersAndClose()
    {
        // Copy temp values to actual filter values
        filterAbn = tempFilterAbn;
        filterSuccess = tempFilterSuccess;
        filterInitiatedBy = tempFilterInitiatedBy;
        filterDateFrom = tempFilterDateFrom;
        filterDateTo = tempFilterDateTo;

        showFilterPopover = false;
        await ApplyFilters();
    }

    private async Task ClearFiltersAndClose()
    {
        // Clear both temp and actual filter values
        tempFilterAbn = "";
        tempFilterSuccess = "";
        tempFilterInitiatedBy = "";
        tempFilterDateFrom = null;
        tempFilterDateTo = null;

        filterAbn = "";
        filterSuccess = "";
        filterInitiatedBy = "";
        filterDateFrom = null;
        filterDateTo = null;

        showFilterPopover = false;
        await ApplyFilters();
    }

    private async Task NextPage()
    {
        if (currentPage * pageSize < totalCount)
        {
            currentPage++;
            await LoadData();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadData();
        }
    }

    private void ShowErrorModal(string errorMessage)
    {
        currentErrorMessage = errorMessage;
        showErrorModal = true;
    }

    private void CloseErrorModal()
    {
        showErrorModal = false;
        currentErrorMessage = "";
    }
}
