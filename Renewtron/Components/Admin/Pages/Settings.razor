@page "/admin/settings"

@using Renewtron.Abstractions
@using Renewtron.Settings

@inject ISettingsService SettingsService
@inject NavigationManager Navigation

<PageTitle>Settings - Renewtron</PageTitle>

<div class="min-h-full">
    <AdminNavMenu />

    <header class="relative bg-white shadow-sm">
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
            <h1 class="text-lg/6 font-semibold text-gray-900">Settings</h1>
        </div>
    </header>

    <main>
        <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="mb-4 rounded-md bg-green-50 p-4">
                    <div class="flex">
                        <div class="shrink-0">
                            <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-green-800">@successMessage</p>
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-4 rounded-md bg-red-50 p-4">
                    <div class="flex">
                        <div class="shrink-0">
                            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-red-800">@errorMessage</p>
                        </div>
                    </div>
                </div>
            }

            <!-- Tabs -->
            <div class="mb-6">
                <div class="border-b border-gray-200">
                    <nav class="-mb-px flex space-x-8">
                        <button @onclick="() => activeTab = Tab.SendGrid"
                                class="@(activeTab == Tab.SendGrid ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700") whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium">
                            SendGrid
                        </button>
                        <button @onclick="() => activeTab = Tab.Stripe"
                                class="@(activeTab == Tab.Stripe ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700") whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium">
                            Stripe
                        </button>
                        <button @onclick="() => activeTab = Tab.Pricing"
                                class="@(activeTab == Tab.Pricing ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700") whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium">
                            Pricing
                        </button>
                        <button @onclick="() => activeTab = Tab.AsicCreditCard"
                                class="@(activeTab == Tab.AsicCreditCard ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700") whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium">
                            ASIC Card
                        </button>
                    </nav>
                </div>
            </div>

            @if (activeTab == Tab.SendGrid)
            {
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <div class="px-4 py-5 sm:p-6">
                        <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">SendGrid Email Settings</h3>
                        <EditForm Model="@sendGridSettings" OnValidSubmit="SaveSendGridSettings">
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">API Key</label>
                                    <InputText @bind-Value="sendGridSettings.ApiKey" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">From Email</label>
                                    <InputText @bind-Value="sendGridSettings.FromEmail" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">From Name</label>
                                    <InputText @bind-Value="sendGridSettings.FromName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" />
                                </div>
                                <div>
                                    <button type="submit" class="inline-flex justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                        Save SendGrid Settings
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else if (activeTab == Tab.Stripe)
            {
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <div class="px-4 py-5 sm:p-6">
                        <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Stripe Payment Settings</h3>
                        <EditForm Model="@stripeSettings" OnValidSubmit="SaveStripeSettings">
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Secret Key</label>
                                    <InputText @bind-Value="stripeSettings.SecretKey" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" type="password" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Publishable Key</label>
                                    <InputText @bind-Value="stripeSettings.PublishableKey" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" />
                                </div>
                                <div>
                                    <button type="submit" class="inline-flex justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                        Save Stripe Settings
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else if (activeTab == Tab.Pricing)
            {
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <div class="px-4 py-5 sm:p-6">
                        <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Renewal Pricing</h3>
                        <p class="text-sm text-gray-500 mb-4">Set the prices customers will pay for business name renewals</p>
                        <EditForm Model="@pricingSettings" OnValidSubmit="SavePricingSettings">
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">1 Year Renewal Price</label>
                                    <div class="relative mt-1 rounded-md shadow-sm">
                                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                            <span class="text-gray-500 sm:text-sm">$</span>
                                        </div>
                                        <InputNumber @bind-Value="pricingSettings.OneYearFee" class="block w-full rounded-md border-gray-300 pl-7 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" />
                                    </div>
                                    <p class="mt-1 text-xs text-gray-500">Total price charged to customer for 1 year renewal</p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">3 Year Renewal Price</label>
                                    <div class="relative mt-1 rounded-md shadow-sm">
                                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                            <span class="text-gray-500 sm:text-sm">$</span>
                                        </div>
                                        <InputNumber @bind-Value="pricingSettings.ThreeYearFee" class="block w-full rounded-md border-gray-300 pl-7 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" />
                                    </div>
                                    <p class="mt-1 text-xs text-gray-500">Total price charged to customer for 3 year renewal</p>
                                </div>
                                <div>
                                    <button type="submit" class="inline-flex justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                        Save Pricing Settings
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else
            {
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <div class="px-4 py-5 sm:p-6">
                        <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">ASIC Credit Card Settings</h3>
                        <EditForm Model="@asicCreditCardSettings" OnValidSubmit="SaveAsicCreditCardSettings">
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Card Number</label>
                                    <InputText @bind-Value="asicCreditCardSettings.CardNumber" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Cardholder Name</label>
                                    <InputText @bind-Value="asicCreditCardSettings.CardholderName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" />
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Expiry Month</label>
                                        <InputText @bind-Value="asicCreditCardSettings.ExpiryMonth" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Expiry Year</label>
                                        <InputText @bind-Value="asicCreditCardSettings.ExpiryYear" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" />
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">CVC</label>
                                    <InputText @bind-Value="asicCreditCardSettings.Cvc" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" type="password" />
                                </div>
                                <div>
                                    <button type="submit" class="inline-flex justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                        Save ASIC Card Settings
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </main>
</div>

@code {
    private enum Tab { SendGrid, Stripe, Pricing, AsicCreditCard }

    private Tab activeTab = Tab.SendGrid;

    private SendGridSettings sendGridSettings = new();
    private StripeSettings stripeSettings = new();
    private PricingSettings pricingSettings = new();
    private AsicCreditCardSettings asicCreditCardSettings = new();

    private string successMessage = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        sendGridSettings = await SettingsService.GetSendGridSettingsAsync();
        stripeSettings = await SettingsService.GetStripeSettingsAsync();
        pricingSettings = await SettingsService.GetPricingSettingsAsync();
        asicCreditCardSettings = await SettingsService.GetAsicCreditCardSettingsAsync();
    }

    private async Task SaveSendGridSettings()
    {
        try
        {
            await SettingsService.UpdateSendGridSettingsAsync(sendGridSettings);
            successMessage = "SendGrid settings saved successfully!";
            errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving SendGrid settings: {ex.Message}";
            successMessage = "";
        }
    }

    private async Task SaveStripeSettings()
    {
        try
        {
            await SettingsService.UpdateStripeSettingsAsync(stripeSettings);
            successMessage = "Stripe settings saved successfully!";
            errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving Stripe settings: {ex.Message}";
            successMessage = "";
        }
    }

    private async Task SavePricingSettings()
    {
        try
        {
            await SettingsService.UpdatePricingSettingsAsync(pricingSettings);
            successMessage = "Pricing settings saved successfully!";
            errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving Pricing settings: {ex.Message}";
            successMessage = "";
        }
    }

    private async Task SaveAsicCreditCardSettings()
    {
        try
        {
            await SettingsService.UpdateAsicCreditCardSettingsAsync(asicCreditCardSettings);
            successMessage = "ASIC Credit Card settings saved successfully!";
            errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving ASIC Credit Card settings: {ex.Message}";
            successMessage = "";
        }
    }
}
