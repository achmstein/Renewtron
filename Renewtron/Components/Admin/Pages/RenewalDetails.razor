@page "/admin/renewals/{id:guid}"

@using Renewtron.Data
@using Renewtron.Abstractions
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext
@inject IRenewalRetryService RetryService
@inject NavigationManager Navigation

<PageTitle>Renewal Request Details - Renewtron</PageTitle>

<div class="min-h-full">
    <AdminNavMenu />

    <header class="relative bg-white shadow-sm">
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between">
                <h1 class="text-lg/6 font-semibold text-gray-900">Renewal Request Details</h1>
                <a href="/admin/renewals" class="text-sm text-gray-600 hover:text-gray-900">
                    ← Back to Renewals
                </a>
            </div>
        </div>
    </header>

    <main>
        <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
            @if (isLoading)
            {
                <div class="text-center py-12">
                    <svg class="mx-auto h-12 w-12 animate-spin text-indigo-600" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <p class="mt-4 text-sm text-gray-600">Loading...</p>
                </div>
            }
            else if (renewal == null)
            {
                <div class="text-center py-12">
                    <h3 class="text-lg font-semibold text-gray-900">Renewal Request Not Found</h3>
                    <p class="mt-2 text-sm text-gray-600">The renewal request you're looking for doesn't exist.</p>
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="mb-4 rounded-md bg-green-50 p-4">
                        <div class="flex">
                            <div class="shrink-0">
                                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-green-800">@successMessage</p>
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-4 rounded-md bg-red-50 p-4">
                        <div class="flex">
                            <div class="shrink-0">
                                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-red-800">@errorMessage</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- Status Overview -->
                <div class="mb-6 overflow-hidden rounded-lg bg-white shadow">
                    <div class="px-6 py-5">
                        <div class="flex items-center justify-between">
                            <div>
                                <h2 class="text-2xl font-bold text-gray-900">@renewal.SearchResult?.BusinessName</h2>
                                <p class="mt-1 text-sm text-gray-500">ABN: @renewal.SearchResult?.SearchLog?.Abn</p>
                            </div>
                            <div class="text-right">
                                @switch (renewal.Status)
                                {
                                    case RenewalStatus.Completed:
                                        <span class="inline-flex rounded-full bg-green-100 px-3 py-1 text-sm font-semibold leading-5 text-green-800">Completed</span>
                                        break;
                                    case RenewalStatus.Processing:
                                        <span class="inline-flex rounded-full bg-blue-100 px-3 py-1 text-sm font-semibold leading-5 text-blue-800">Processing</span>
                                        break;
                                    case RenewalStatus.Pending:
                                        <span class="inline-flex rounded-full bg-yellow-100 px-3 py-1 text-sm font-semibold leading-5 text-yellow-800">Pending</span>
                                        break;
                                    case RenewalStatus.Failed:
                                        <span class="inline-flex rounded-full bg-red-100 px-3 py-1 text-sm font-semibold leading-5 text-red-800">Failed</span>
                                        break;
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                    <!-- Renewal Information -->
                    <div class="overflow-hidden rounded-lg bg-white shadow">
                        <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
                            <h3 class="text-base font-semibold text-gray-900">Renewal Information</h3>
                        </div>
                        <div class="px-6 py-4">
                            <dl class="space-y-4">
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Request ID</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-mono">@renewal.Id</dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Initiated At</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@renewal.InitiatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Initiated By</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@renewal.SearchResult.SearchLog.InitiatedBy.ToString()</dd>
                                </div>
                                @if (renewal.CompletedAt.HasValue)
                                {
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Completed At</dt>
                                        <dd class="mt-1 text-sm text-gray-900">@renewal.CompletedAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</dd>
                                    </div>
                                }
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Renewal Period</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@renewal.RenewalYears year@(renewal.RenewalYears > 1 ? "s" : "")</dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Customer Email</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@renewal.Email</dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">IP Address</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-mono">
                                        <span>@renewal.SearchResult.SearchLog.IpAddress</span>
                                    </dd>
                                </div>
                            </dl>
                        </div>
                    </div>

                    <!-- Payment Information -->
                    <div class="overflow-hidden rounded-lg bg-white shadow">
                        <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
                            <h3 class="text-base font-semibold text-gray-900">Payment Information</h3>
                        </div>
                        <div class="px-6 py-4">
                            <dl class="space-y-4">
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Payment Type</dt>
                                    <dd class="mt-1">
                                        @if (renewal.PaymentType == PaymentType.External)
                                        {
                                            <span class="inline-flex rounded-full bg-blue-100 px-2 text-xs font-semibold leading-5 text-blue-800">External Payment</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex rounded-full bg-purple-100 px-2 text-xs font-semibold leading-5 text-purple-800">Stripe Payment</span>
                                        }
                                    </dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Amount</dt>
                                    <dd class="mt-1 text-lg font-semibold text-gray-900">$@renewal.Amount.ToString("F2")</dd>
                                </div>
                                @if (renewal.StripePayment != null)
                                {
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Stripe Payment Intent</dt>
                                        <dd class="mt-1 text-sm text-gray-900 font-mono break-all">@renewal.StripePayment.PaymentIntentId</dd>
                                    </div>
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Stripe Payment Status</dt>
                                        <dd class="mt-1">
                                            @if (renewal.StripePayment.PaymentStatus == "succeeded")
                                            {
                                                <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Succeeded</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">@renewal.StripePayment.PaymentStatus</span>
                                            }
                                        </dd>
                                    </div>
                                }
                                @if (renewal.StripePayment?.PaidAt.HasValue ?? false)
                                {
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Paid At</dt>
                                        <dd class="mt-1 text-sm text-gray-900">@renewal.StripePayment.PaidAt!.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</dd>
                                    </div>
                                }
                            </dl>
                        </div>
                    </div>

                    <!-- ASIC Transaction Details -->
                    <div class="overflow-hidden rounded-lg bg-white shadow">
                        <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
                            <h3 class="text-base font-semibold text-gray-900">ASIC Transaction Details</h3>
                        </div>
                        <div class="px-6 py-4">
                            <dl class="space-y-4">
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Transaction Reference</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-mono">@(renewal.TransactionReference ?? "N/A")</dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Hosted Tokenization ID</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-mono break-all">@(renewal.HostedTokenizationId ?? "N/A")</dd>
                                </div>
                                @if (!string.IsNullOrEmpty(renewal.ErrorMessage))
                                {
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Error Message</dt>
                                        <dd class="mt-1 text-sm text-red-600">@renewal.ErrorMessage</dd>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(renewal.FailedAtStep))
                                {
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Failed At Step</dt>
                                        <dd class="mt-1">
                                            <span class="inline-flex items-center rounded-md bg-red-100 px-2.5 py-1 text-xs font-medium text-red-800">
                                                @renewal.FailedAtStep
                                            </span>
                                        </dd>
                                    </div>
                                }
                            </dl>
                        </div>
                    </div>

                    <!-- Customer Credit Card -->
                    @if (renewal.StripePayment?.CustomerCreditCard != null)
                    {
                        <div class="overflow-hidden rounded-lg bg-white shadow">
                            <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
                                <h3 class="text-base font-semibold text-gray-900">Customer Credit Card</h3>
                            </div>
                            <div class="px-6 py-4">
                                <dl class="space-y-4">
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Cardholder Name</dt>
                                        <dd class="mt-1 text-sm text-gray-900">@renewal.StripePayment.CustomerCreditCard.CardholderName</dd>
                                    </div>
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Card Number</dt>
                                        <dd class="mt-1 text-sm text-gray-900 font-mono">**** **** **** @renewal.StripePayment.CustomerCreditCard.CardNumberLast4</dd>
                                    </div>
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Card Brand</dt>
                                        <dd class="mt-1 text-sm text-gray-900">@renewal.StripePayment.CustomerCreditCard.CardBrand</dd>
                                    </div>
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Expiry</dt>
                                        <dd class="mt-1 text-sm text-gray-900">@renewal.StripePayment.CustomerCreditCard.ExpiryMonth/@renewal.StripePayment.CustomerCreditCard.ExpiryYear</dd>
                                    </div>
                                </dl>
                            </div>
                        </div>
                    }
                </div>

                <!-- Action Buttons -->
                @if (renewal.Status == RenewalStatus.Failed && ((renewal.PaymentType == PaymentType.Stripe && renewal.StripePayment?.PaymentStatus == "succeeded")
                            || renewal.PaymentType == PaymentType.External))
                {
                    <div class="mt-6 flex justify-end">
                        <button @onclick="RetryRenewal"
                                disabled="@isRetrying"
                                class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed">
                            @if (isRetrying)
                            {
                                <svg class="animate-spin h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Retrying...</span>
                            }
                            else
                            {
                                <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                                </svg>
                                <span>Retry Renewal</span>
                            }
                        </button>
                    </div>
                }
            }
        </div>
    </main>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private RenewalRequest? renewal;
    private bool isLoading = true;
    private bool isRetrying = false;
    private string successMessage = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        renewal = await DbContext.RenewalRequests
            .Include(r => r.SearchResult)
                .ThenInclude(sr => sr.SearchLog)
            .Include(r => r.StripePayment)
                .ThenInclude(sp => sp.CustomerCreditCard)
            .FirstOrDefaultAsync(r => r.Id == Id);
        isLoading = false;
    }

    private async Task RetryRenewal()
    {
        isRetrying = true;
        successMessage = "";
        errorMessage = "";

        try
        {
            var (success, message) = await RetryService.RetryRenewalAsync(Id);

            if (success)
            {
                successMessage = message;
                await LoadData(); // Reload to show updated status
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isRetrying = false;
        }
    }
}
