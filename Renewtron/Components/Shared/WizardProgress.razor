@* Wizard Progress Component - Shows current step in a multi-step wizard *@

<nav aria-label="Progress" class="mb-8">
    <ol role="list" class="flex items-center justify-center">
        @for (int i = 0; i < Steps.Count; i++)
        {
            var step = Steps[i];
            var stepNumber = i + 1;
            var isCompleted = stepNumber < CurrentStep;
            var isCurrent = stepNumber == CurrentStep;
            var isClickable = isCompleted && AllowNavigation;

            <li class="@(i < Steps.Count - 1 ? "flex-1" : "") relative @(i > 0 ? "pl-4 sm:pl-8" : "")">
                @if (i > 0)
                {
                    <!-- Connector line -->
                    <div class="absolute left-0 top-4 -ml-px h-0.5 w-full @(isCompleted ? "bg-blue-600" : "bg-gray-200")" aria-hidden="true"></div>
                }

                <div class="group relative flex items-start @(isClickable ? "cursor-pointer" : "")" @onclick="() => HandleStepClick(stepNumber)">
                    <span class="flex h-9 items-center" aria-hidden="true">
                        @if (isCompleted)
                        {
                            <!-- Completed step -->
                            <span class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full bg-blue-600 @(isClickable ? "group-hover:bg-blue-800" : "")">
                                <svg class="h-5 w-5 text-white" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                                </svg>
                            </span>
                        }
                        else if (isCurrent)
                        {
                            <!-- Current step -->
                            <span class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full border-2 border-blue-600 bg-white">
                                <span class="h-2.5 w-2.5 rounded-full bg-blue-600"></span>
                            </span>
                        }
                        else
                        {
                            <!-- Upcoming step -->
                            <span class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full border-2 border-gray-300 bg-white">
                                <span class="h-2.5 w-2.5 rounded-full bg-transparent"></span>
                            </span>
                        }
                    </span>
                    <span class="ml-3 flex min-w-0 flex-col">
                        <span class="text-xs font-medium @(isCurrent ? "text-blue-600" : isCompleted ? "text-gray-900" : "text-gray-500")">
                            @step.Label
                        </span>
                    </span>
                </div>
            </li>
        }
    </ol>
</nav>

@code {
    [Parameter]
    public int CurrentStep { get; set; } = 1;

    [Parameter]
    public List<WizardStep> Steps { get; set; } = new();

    [Parameter]
    public bool AllowNavigation { get; set; } = true;

    [Parameter]
    public EventCallback<int> OnStepClick { get; set; }

    private async Task HandleStepClick(int step)
    {
        if (AllowNavigation && step < CurrentStep && OnStepClick.HasDelegate)
        {
            await OnStepClick.InvokeAsync(step);
        }
    }

    public class WizardStep
    {
        public string Label { get; set; } = "";
    }
}
