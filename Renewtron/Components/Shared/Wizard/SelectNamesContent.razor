@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using Renewtron.Services
@using Renewtron.Data
@using Renewtron.Settings

@inject NavigationManager Navigation
@inject ILeadService LeadService
@inject ApplicationDbContext DbContext
@inject IOptionsSnapshot<PricingSettings> PricingSettings

<div class="relative isolate overflow-auto flex-1">
    <!-- Background Pattern -->
    <svg class="absolute inset-0 -z-10 h-full w-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]" aria-hidden="true">
        <defs>
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M.5 40V.5H40" fill="none" />
            </pattern>
        </defs>
        <rect width="100%" height="100%" stroke-width="0" fill="url(#grid)" />
    </svg>

    <div class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:px-8 lg:py-12">
        <!-- Wizard Progress -->
        <WizardProgress CurrentStep="4" Steps="@wizardSteps" AllowNavigation="true" OnStepClick="HandleStepClick" />

        @if (lead != null)
        {
            <!-- User Details Summary -->
            <div class="mx-auto max-w-2xl">
                <UserDetailsSummary Abn="@lead.Abn"
                                    FullName="@lead.FullName"
                                    Email="@lead.Email"
                                    MobileNumber="@lead.MobileNumber"
                                    DateOfBirth="@lead.DateOfBirth"
                                    ShowEditButton="true"
                                    OnEditClick="GoToDetails" />
            </div>

            <div class="mx-auto max-w-2xl">
                <div class="text-center mb-8">
                    <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
                        Select business names to renew
                    </h1>
                    <p class="mt-2 text-sm text-gray-600">
                        Choose which business names you'd like to renew
                    </p>
                </div>

                @if (businessNames != null && businessNames.Any())
                {
                    <!-- Selection Controls -->
                    <div class="flex items-center justify-between mb-4">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox"
                                   checked="@AreAllSelected()"
                                   @onchange="ToggleSelectAll"
                                   class="h-4 w-4 rounded border-gray-300 accent-brand focus:ring-brand" />
                            <span class="text-sm font-medium text-gray-700">Select all</span>
                        </label>
                        @if (selectedIds.Any())
                        {
                            <span class="text-sm text-gray-500">@selectedIds.Count selected</span>
                        }
                    </div>

                    <!-- Business Names List -->
                    <div class="space-y-3 mb-8">
                        @foreach (var business in businessNames)
                        {
                            <div class="overflow-hidden rounded-lg bg-white shadow ring-1 @(IsSelected(business.Id) ? "ring-brand ring-2" : "ring-gray-200") cursor-pointer transition-all hover:shadow-md"
                                 @onclick="() => ToggleSelection(business.Id)">
                                <div class="px-5 py-4">
                                    <div class="flex items-start gap-4">
                                        <div class="flex items-center pt-0.5">
                                            <input type="checkbox"
                                                   checked="@IsSelected(business.Id)"
                                                   @onclick:stopPropagation="true"
                                                   @onchange="() => ToggleSelection(business.Id)"
                                                   class="h-5 w-5 rounded border-gray-300 accent-brand focus:ring-brand cursor-pointer" />
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h3 class="text-base font-semibold text-gray-900 truncate">@business.BusinessName</h3>
                                            <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500">
                                                <span>Account: @business.AccountNumber</span>
                                                <span>Registered: @business.RegistrationDate</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Renewal Period Selection -->
                    <div class="rounded-lg bg-white shadow ring-1 ring-gray-200 p-5 mb-6">
                        <h3 class="text-sm font-semibold text-gray-900 mb-4">Select renewal period</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <label class="relative flex cursor-pointer rounded-lg border @(renewalYears == 1 ? "border-brand ring-2 ring-brand" : "border-gray-200") bg-white p-4 shadow-sm focus:outline-none hover:border-gray-300 transition-all">
                                <input type="radio"
                                       name="renewal-period"
                                       value="1"
                                       checked="@(renewalYears == 1)"
                                       @onchange="() => SetRenewalYears(1)"
                                       class="sr-only" />
                                <div class="flex flex-1 flex-col">
                                    <span class="block text-sm font-semibold text-gray-900">1 Year</span>
                                    <span class="mt-1 text-2xl font-bold text-gray-900">$@PricingSettings.Value.OneYearFee.ToString("F0")</span>
                                    <span class="mt-1 text-xs text-gray-500">per business name</span>
                                </div>
                                @if (renewalYears == 1)
                                {
                                    <svg class="h-5 w-5 text-brand" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                    </svg>
                                }
                            </label>

                            <label class="relative flex cursor-pointer rounded-lg border @(renewalYears == 3 ? "border-brand ring-2 ring-brand" : "border-gray-200") bg-white p-4 shadow-sm focus:outline-none hover:border-gray-300 transition-all">
                                <input type="radio"
                                       name="renewal-period"
                                       value="3"
                                       checked="@(renewalYears == 3)"
                                       @onchange="() => SetRenewalYears(3)"
                                       class="sr-only" />
                                <div class="flex flex-1 flex-col">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-semibold text-gray-900">3 Years</span>
                                        <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Save</span>
                                    </div>
                                    <span class="mt-1 text-2xl font-bold text-gray-900">$@PricingSettings.Value.ThreeYearFee.ToString("F0")</span>
                                    <span class="mt-1 text-xs text-gray-500">per business name</span>
                                </div>
                                @if (renewalYears == 3)
                                {
                                    <svg class="h-5 w-5 text-brand" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                    </svg>
                                }
                            </label>
                        </div>
                    </div>

                    <!-- Price Summary -->
                    @if (selectedIds.Any())
                    {
                        <div class="rounded-lg bg-gray-50 border border-gray-200 p-5 mb-6">
                            <h3 class="text-sm font-semibold text-gray-900 mb-3">Order Summary</h3>
                            <div class="space-y-2 text-sm">
                                <div class="flex justify-between text-gray-600">
                                    <span>@selectedIds.Count business name@(selectedIds.Count > 1 ? "s" : "") x @renewalYears year@(renewalYears > 1 ? "s" : "")</span>
                                    <span>$@GetPricePerItem().ToString("F2") each</span>
                                </div>
                                <div class="border-t border-gray-200 pt-2 mt-2 flex justify-between font-semibold text-gray-900">
                                    <span>Total</span>
                                    <span>$@GetTotalPrice().ToString("F2")</span>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Proceed Button -->
                    <button @onclick="ProceedToPayment"
                            disabled="@(!selectedIds.Any())"
                            class="w-full flex justify-center items-center rounded-md bg-brand px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-brand transition-colors">
                        Proceed to Payment
                        <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                    </button>

                    <!-- Back Link -->
                    <div class="text-center mt-4">
                        <button type="button" @onclick="GoBack" class="text-sm font-medium text-gray-600 hover:text-gray-500">
                            <svg class="inline-block mr-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                            </svg>
                            Back
                        </button>
                    </div>
                }
                else
                {
                    <!-- No business names -->
                    <div class="text-center py-12">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <h3 class="mt-4 text-lg font-semibold text-gray-900">No business names found</h3>
                        <p class="mt-2 text-sm text-gray-600">We couldn't find any business names to renew.</p>
                        <div class="mt-6">
                            <button @onclick="GoToStart" class="inline-flex items-center rounded-md bg-brand px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-dark">
                                Try another ABN
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Loading -->
            <div class="text-center py-12">
                <svg class="mx-auto h-12 w-12 animate-spin text-brand" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string RoutePrefix { get; set; } = "";

    [Parameter]
    public Guid LeadId { get; set; }

    private Lead? lead;
    private List<SearchResult>? businessNames;
    private HashSet<Guid> selectedIds = new();
    private int renewalYears = 1;

    private List<WizardProgress.WizardStep> wizardSteps = new()
    {
        new() { Label = "ABN" },
        new() { Label = "Details" },
        new() { Label = "Check" },
        new() { Label = "Select" },
        new() { Label = "Pay" }
    };

    protected override async Task OnInitializedAsync()
    {
        lead = await LeadService.GetLeadWithSearchResultsAsync(LeadId);

        if (lead == null)
        {
            Navigation.NavigateTo($"{RoutePrefix}/start");
            return;
        }

        if (lead.SearchLog?.Results != null)
        {
            businessNames = lead.SearchLog.Results.ToList();
            // Auto-select all by default
            foreach (var bn in businessNames)
            {
                selectedIds.Add(bn.Id);
            }
        }
    }

    private bool IsSelected(Guid id) => selectedIds.Contains(id);

    private bool AreAllSelected() => businessNames != null &&
                                     businessNames.Any() &&
                                     businessNames.All(b => selectedIds.Contains(b.Id));

    private void ToggleSelection(Guid id)
    {
        if (selectedIds.Contains(id))
            selectedIds.Remove(id);
        else
            selectedIds.Add(id);
    }

    private void ToggleSelectAll()
    {
        if (AreAllSelected())
        {
            selectedIds.Clear();
        }
        else if (businessNames != null)
        {
            foreach (var bn in businessNames)
            {
                selectedIds.Add(bn.Id);
            }
        }
    }

    private void SetRenewalYears(int years)
    {
        renewalYears = years;
    }

    private decimal GetPricePerItem()
    {
        return PricingSettings.Value.GetCustomerPrice(renewalYears);
    }

    private decimal GetTotalPrice()
    {
        return GetPricePerItem() * selectedIds.Count;
    }

    private void HandleStepClick(int step)
    {
        switch (step)
        {
            case 1:
                GoToStart();
                break;
            case 2:
                GoToDetails();
                break;
        }
    }

    private void GoToStart()
    {
        Navigation.NavigateTo($"{RoutePrefix}/start");
    }

    private void GoToDetails()
    {
        Navigation.NavigateTo($"{RoutePrefix}/details?abn={lead?.Abn}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"{RoutePrefix}/details?abn={lead?.Abn}");
    }

    private void ProceedToPayment()
    {
        if (selectedIds.Any() && lead != null)
        {
            var ids = string.Join(",", selectedIds);
            Navigation.NavigateTo($"{RoutePrefix}/payment/{lead.Id}?ids={ids}&years={renewalYears}");
        }
    }
}
