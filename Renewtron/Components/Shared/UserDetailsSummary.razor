@* User Details Summary Component - Compact display of captured user information *@

<div class="rounded-lg bg-gray-50 border border-gray-200 p-4 mb-6">
    <div class="flex items-start gap-3">
        <div class="flex-shrink-0">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100">
                <svg class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                </svg>
            </div>
        </div>
        <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">
                    ABN: @FormatAbn(Abn)
                </span>
            </div>
            <p class="mt-1 text-sm font-medium text-gray-900">@FullName</p>
            <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500">
                <span class="flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                    @Email
                </span>
                <span class="flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                    </svg>
                    @MobileNumber
                </span>
                @if (DateOfBirth.HasValue)
                {
                    <span class="flex items-center gap-1">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                        </svg>
                        DOB: @DateOfBirth.Value.ToString("dd/MM/yyyy")
                    </span>
                }
            </div>
        </div>
        @if (ShowEditButton)
        {
            <div class="flex-shrink-0">
                <button type="button" @onclick="OnEditClick" class="text-sm font-medium text-blue-600 hover:text-blue-500">
                    Edit
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Abn { get; set; } = "";

    [Parameter]
    public string FullName { get; set; } = "";

    [Parameter]
    public string Email { get; set; } = "";

    [Parameter]
    public string MobileNumber { get; set; } = "";

    [Parameter]
    public DateOnly? DateOfBirth { get; set; }

    [Parameter]
    public bool ShowEditButton { get; set; } = false;

    [Parameter]
    public EventCallback OnEditClick { get; set; }

    private string FormatAbn(string abn)
    {
        if (string.IsNullOrEmpty(abn)) return "";
        var clean = abn.Replace(" ", "");
        if (clean.Length == 11)
        {
            return $"{clean[..2]} {clean[2..5]} {clean[5..8]} {clean[8..]}";
        }
        return abn;
    }
}
