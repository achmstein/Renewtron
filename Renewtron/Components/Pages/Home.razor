@page "/"

@using Asic.Client
@using Asic.Client.Abstractions
@using Asic.Client.Models

@inject IAsicRegistrySearchClient AsicRegistrySearchClient
@inject NavigationManager Navigation

<PageTitle>Business Name Renewal</PageTitle>

<div class="min-h-screen bg-white">
    @if (!isSearching && searchResult == null)
    {
        <!-- Landing Page - Tailwind UI Pro Style -->
        <div class="relative isolate overflow-hidden">
            <!-- Background Pattern -->
            <svg class="absolute inset-0 -z-10 h-full w-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]" aria-hidden="true">
                <defs>
                    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M.5 40V.5H40" fill="none" />
                    </pattern>
                </defs>
                <rect width="100%" height="100%" stroke-width="0" fill="url(#grid)" />
            </svg>

            <div class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:px-8 lg:py-20">
                <!-- Logo -->
                <div class="flex justify-center mb-8">
                    <div class="flex items-center gap-2">
                        <img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=blue&shade=700" alt="Renewtron" class="h-10 w-auto" />
                        <span class="text-2xl font-semibold text-gray-900">Renewtron</span>
                    </div>
                </div>

                <div class="mx-auto max-w-2xl text-center">
                    <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl">
                        Renew your business name
                    </h1>
                    <p class="mt-6 text-lg leading-8 text-gray-600">
                        Complete your business name renewal in minutes. Enter your ABN to get started with our secure and streamlined process.
                    </p>
                </div>

                <!-- Search Card -->
                <div class="mx-auto mt-16 max-w-xl">
                    <form @onsubmit="HandleSearch" @onsubmit:preventDefault>
                        <div class="space-y-6">
                            <div>
                                <label for="abn" class="block text-sm font-medium leading-6 text-gray-900">
                                    Australian Business Number
                                </label>
                                <div class="mt-2">
                                    <input type="text"
                                           id="abn"
                                           @bind="abn"
                                           @bind:event="oninput"
                                           placeholder="12345678901"
                                           maxlength="14"
                                           class="block w-full rounded-md border-0 py-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 px-4"
                                           required />
                                </div>
                                @if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <p class="mt-2 text-sm text-red-600">@errorMessage</p>
                                }
                            </div>

                            <button type="submit"
                                    disabled="@(!IsValidAbn())"
                                    class="flex w-full justify-center rounded-md bg-indigo-600 px-3 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-indigo-600">
                                Search business names
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Features -->
                <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl">
                    <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-3 lg:gap-y-16">
                        <div class="relative">
                            <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
                                <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-indigo-600">
                                    <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                                    </svg>
                                </div>
                                Secure payment
                            </dt>
                            <dd class="mt-2 text-base leading-7 text-gray-600">Bank-level encryption protects your information</dd>
                        </div>

                        <div class="relative">
                            <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
                                <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-indigo-600">
                                    <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                                    </svg>
                                </div>
                                Instant processing
                            </dt>
                            <dd class="mt-2 text-base leading-7 text-gray-600">Complete your renewal in just a few minutes</dd>
                        </div>

                        <div class="relative">
                            <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
                                <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-indigo-600">
                                    <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                ASIC verified
                            </dt>
                            <dd class="mt-2 text-base leading-7 text-gray-600">Direct integration with official records</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    }
    else if (isSearching)
    {
        <!-- Loading State - Tailwind UI Pro Style -->
        <div class="flex min-h-screen items-center justify-center px-6">
            <div class="w-full max-w-sm">
                <div class="text-center">
                    <!-- Spinner -->
                    <div class="mx-auto mb-8 flex h-16 w-16 items-center justify-center">
                        <svg class="h-16 w-16 animate-spin text-indigo-600" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>

                    <h2 class="text-lg font-semibold text-gray-900">Processing your request</h2>
                    <p class="mt-2 text-sm text-gray-600">This typically takes 20-25 seconds</p>

                    <!-- Status Message -->
                    <div class="mt-8">
                        <div class="flex items-center justify-center gap-2 text-sm text-gray-600">
                            <div class="h-2 w-2 animate-pulse rounded-full bg-indigo-600"></div>
                            <span>@loadingMessage</span>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="mt-8">
                        <div class="h-2 w-full overflow-hidden rounded-full bg-gray-200">
                            <div class="h-full rounded-full bg-indigo-600 transition-all duration-500" style="width: @(progress)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (searchResult != null)
    {
        <!-- Results Page - Tailwind UI Pro Style -->
        <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-gray-200 pb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Search results</h1>
                    <p class="mt-1 text-sm text-gray-600">ABN: @abn</p>
                </div>
                <button @onclick="ResetSearch"
                        class="inline-flex items-center gap-x-2 rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>
                    New search
                </button>
            </div>

            @if (searchResult.Success && searchResult.Data?.Succeeded == true && searchResult.Data.BusinessNames?.Any() == true)
            {
                <!-- Results List -->
                <div class="mt-8 space-y-6">
                    @foreach (var business in searchResult.Data.BusinessNames)
                    {
                        <div class="overflow-hidden rounded-lg bg-white shadow ring-1 ring-black ring-opacity-5">
                            <div class="px-6 py-6">
                                <div class="flex items-start justify-between">
                                    <div class="flex-1">
                                        <h3 class="text-xl font-semibold text-gray-900">@business.Name</h3>
                                        <div class="mt-2">
                                            <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset @GetStatusClass(business.Status)">
                                                @business.Status
                                            </span>
                                        </div>
                                    </div>
                                    <button @onclick="() => HandleRenewal(business.Name)"
                                            class="ml-4 inline-flex items-center gap-x-2 rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                        Pay now
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                        </svg>
                                    </button>
                                </div>

                                <!-- Business Details -->
                                <dl class="mt-6 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
                                    @if (!string.IsNullOrEmpty(business.RegistrationDate))
                                    {
                                        <div>
                                            <dt class="text-sm font-medium text-gray-500">Registration date</dt>
                                            <dd class="mt-1 text-sm text-gray-900">@business.RegistrationDate</dd>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(business.RenewalDate))
                                    {
                                        <div>
                                            <dt class="text-sm font-medium text-gray-500">Renewal date</dt>
                                            <dd class="mt-1 text-sm text-gray-900">@business.RenewalDate</dd>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(business.CancelledDate))
                                    {
                                        <div>
                                            <dt class="text-sm font-medium text-gray-500">Cancelled date</dt>
                                            <dd class="mt-1 text-sm text-gray-900">@business.CancelledDate</dd>
                                        </div>
                                    }
                                </dl>

                                @if (business.Holders?.Any() == true)
                                {
                                    <div class="mt-6 border-t border-gray-200 pt-6">
                                        <h4 class="text-sm font-medium text-gray-900">Holders</h4>
                                        <ul role="list" class="mt-3 space-y-3">
                                            @foreach (var holder in business.Holders)
                                            {
                                                <li class="flex items-center justify-between rounded-md bg-gray-50 px-4 py-3">
                                                    <div>
                                                        <p class="text-sm font-medium text-gray-900">@holder.Name</p>
                                                        <p class="text-xs text-gray-500">@holder.Type</p>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(holder.Abn))
                                                    {
                                                        <p class="text-xs text-gray-500">ABN: @holder.Abn</p>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(business.AddressForServiceDocuments))
                                {
                                    <div class="mt-6 border-t border-gray-200 pt-6">
                                        <dt class="text-sm font-medium text-gray-900">Address for service</dt>
                                        <dd class="mt-2 text-sm text-gray-700">@business.AddressForServiceDocuments</dd>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(business.PrincipalPlaceOfBusiness))
                                {
                                    <div class="mt-6 border-t border-gray-200 pt-6">
                                        <dt class="text-sm font-medium text-gray-900">Principal place of business</dt>
                                        <dd class="mt-2 text-sm text-gray-700">@business.PrincipalPlaceOfBusiness</dd>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="mt-12 text-center">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <h3 class="mt-4 text-lg font-semibold text-gray-900">No business names found</h3>
                    <p class="mt-2 text-sm text-gray-600">We couldn't find any business names registered to this ABN.</p>
                    <div class="mt-6">
                        <button @onclick="ResetSearch"
                                class="inline-flex items-center rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                            Try another ABN
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private string abn = "18184526648";
    private string errorMessage = "";
    private bool isSearching = false;
    private SearchResult<BusinessNamesResponse>? searchResult = null;
    private string loadingMessage = "Connecting to ASIC database...";
    private int progress = 0;
    private Timer? loadingTimer;
    private Timer? progressTimer;

    private readonly string[] loadingMessages = new[]
    {
        "Connecting to ASIC database...",
        "Verifying your ABN...",
        "Retrieving business names...",
        "Processing registration details...",
        "Finalizing results..."
    };

    private bool IsValidAbn()
    {
        var cleanAbn = abn.Replace(" ", "");
        return cleanAbn.Length == 11 && cleanAbn.All(char.IsDigit);
    }

    private async Task HandleSearch()
    {
        errorMessage = "";

        if (!IsValidAbn())
        {
            errorMessage = "Please enter a valid 11-digit ABN";
            return;
        }

        isSearching = true;
        progress = 0;
        var messageIndex = 0;

        loadingTimer = new Timer(_ =>
        {
            messageIndex = (messageIndex + 1) % loadingMessages.Length;
            loadingMessage = loadingMessages[messageIndex];
            InvokeAsync(StateHasChanged);
        }, null, 0, 4000);

        progressTimer = new Timer(_ =>
        {
            if (progress < 95)
            {
                progress += 5;
                InvokeAsync(StateHasChanged);
            }
        }, null, 0, 1000);

        try
        {
            var cleanAbn = abn.Replace(" ", "");
            searchResult = await AsicRegistrySearchClient.SearchAsync(cleanAbn);
            progress = 100;
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while searching. Please try again.";
            searchResult = null;
        }
        finally
        {
            loadingTimer?.Dispose();
            progressTimer?.Dispose();
            isSearching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetSearch()
    {
        abn = "";
        errorMessage = "";
        searchResult = null;
        isSearching = false;
        progress = 0;
    }

    private void HandleRenewal(string businessName)
    {
        // Navigate to payment page or open payment modal
        // Navigation.NavigateTo($"/payment?abn={abn}&business={Uri.EscapeDataString(businessName)}");
    }

    private string GetStatusClass(string status)
    {
        return status?.ToLower() switch
        {
            "registered" => "bg-green-50 text-green-700 ring-green-600/20",
            "active" => "bg-green-50 text-green-700 ring-green-600/20",
            "cancelled" => "bg-red-50 text-red-700 ring-red-600/20",
            "expired" => "bg-yellow-50 text-yellow-800 ring-yellow-600/20",
            _ => "bg-gray-50 text-gray-600 ring-gray-500/10"
        };
    }

    public void Dispose()
    {
        loadingTimer?.Dispose();
        progressTimer?.Dispose();
    }
}