@page "/"

@using Asic.Client
@using Asic.Client.Abstractions
@using Asic.Client.Models
@using Renewtron.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Caching.Memory

@inject IAsicRenewalClient AsicRenewalClient
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IMemoryCache MemoryCache

<PageTitle>Business Name Renewal - Renewtron</PageTitle>

<div class="h-screen bg-white flex flex-col overflow-hidden">
    <!-- Navigation Header with Disclosure -->
    <header class="bg-blue-800">
        <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 items-center justify-between">
                <!-- Logo -->
                <a href="/" class="flex items-center gap-2 shrink-0">
                    <img src="/imgs/logo.svg" alt="Renewtron" class="h-8 w-auto" />
                    <span class="text-lg sm:text-xl font-semibold text-white">Business Name Renewal</span>
                </a>

                <!-- Desktop Navigation Links -->
                <div class="hidden md:flex items-center gap-x-1">
                    <a href="/" class="rounded-md px-3 py-2 text-sm font-medium text-white bg-blue-900/50 hover:bg-blue-900">
                        Renew Business Name
                    </a>
                    <a href="#" class="rounded-md px-3 py-2 text-sm font-medium text-blue-100 hover:bg-blue-700 hover:text-white">
                        Register an ABN
                    </a>
                    <a href="#" class="rounded-md px-3 py-2 text-sm font-medium text-blue-100 hover:bg-blue-700 hover:text-white">
                        Register a Company
                    </a>
                    <a href="#" class="rounded-md px-3 py-2 text-sm font-medium text-blue-100 hover:bg-blue-700 hover:text-white">
                        Contact Us
                    </a>
                </div>

                <!-- Mobile Menu Button (Disclosure Toggle) - Only visible on mobile -->
                <div class="md:hidden">
                    <button type="button"
                            @onclick="ToggleMobileMenu"
                            class="inline-flex items-center justify-center rounded-md p-2 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white"
                            aria-expanded="@mobileMenuOpen">
                        <span class="sr-only">Open main menu</span>
                        @if (!mobileMenuOpen)
                        {
                            <!-- Menu icon -->
                            <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                            </svg>
                        }
                        else
                        {
                            <!-- Close icon -->
                            <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        }
                    </button>
                </div>
            </div>

            <!-- Mobile Navigation Panel (Disclosure Panel) -->
            @if (mobileMenuOpen)
            {
                <div class="md:hidden border-t border-blue-700">
                    <div class="space-y-1 px-2 pb-3 pt-2">
                        <a href="/"
                           class="block rounded-md bg-blue-900 px-3 py-2 text-base font-medium text-white">
                            Renew Business Name
                        </a>
                        <a href="#"
                           class="block rounded-md px-3 py-2 text-base font-medium text-blue-100 hover:bg-blue-700 hover:text-white">
                            Register an ABN
                        </a>
                        <a href="#"
                           class="block rounded-md px-3 py-2 text-base font-medium text-blue-100 hover:bg-blue-700 hover:text-white">
                            Register a Company
                        </a>
                        <a href="#"
                           class="block rounded-md px-3 py-2 text-base font-medium text-blue-100 hover:bg-blue-700 hover:text-white">
                            Contact Us
                        </a>
                    </div>
                </div>
            }
        </nav>
    </header>
    @if (!isSearching)
    {
        <!-- Landing Page - Tailwind UI Pro Style -->
        <div class="relative isolate overflow-auto flex-1">
            <!-- Background Pattern -->
            <svg class="absolute inset-0 -z-10 h-full w-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]" aria-hidden="true">
                <defs>
                    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M.5 40V.5H40" fill="none" />
                    </pattern>
                </defs>
                <rect width="100%" height="100%" stroke-width="0" fill="url(#grid)" />
            </svg>

            <div class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:px-8 lg:py-20">
                <div class="mx-auto max-w-2xl text-center">
                    <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl">
                        Renew your business name
                    </h1>
                    <p class="mt-6 text-lg leading-8 text-gray-600">
                        Complete your business name renewal in minutes. Enter your ABN to get started with our secure and streamlined process.
                    </p>
                </div>

                <!-- Search Card -->
                <div class="mx-auto mt-16 max-w-xl">
                    <form @onsubmit="HandleSearch" @onsubmit:preventDefault>
                        <div class="space-y-6">
                            <div>
                                <label for="abn" class="block text-sm font-medium leading-6 text-gray-900">
                                    Australian Business Number
                                </label>
                                <div class="mt-2">
                                    <input type="text"
                                           id="abn"
                                           @bind="abn"
                                           @bind:event="oninput"
                                           placeholder="12345678901"
                                           maxlength="14"
                                           class="block w-full rounded-md border-0 py-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6 px-4"
                                           required />
                                </div>
                                @if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <p class="mt-2 text-sm text-red-600">@errorMessage</p>
                                }
                            </div>

                            <button type="submit"
                                    disabled="@(!IsValidAbn())"
                                    class="flex w-full justify-center rounded-md bg-blue-600 px-3 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-blue-600">
                                Search business names
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Loading State - Tailwind UI Pro Style -->
        <div class="flex-1 px-6">
            <div class="mx-auto max-w-sm pt-10 lg:pt-20">
                <div class="text-center">
                    <!-- Spinner -->
                    <div class="mx-auto mb-8 flex h-16 w-16 items-center justify-center">
                        <svg class="h-16 w-16 animate-spin text-blue-600" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>

                    <h2 class="text-lg font-semibold text-gray-900">Processing your request</h2>
                    <p class="mt-2 text-sm text-gray-600">This typically takes 20-25 seconds. Please do not close this page.</p>

                    <!-- Status Message -->
                    <div class="mt-8">
                        <div class="flex items-center justify-center gap-2 text-sm text-gray-600">
                            <div class="h-2 w-2 animate-pulse rounded-full bg-blue-600"></div>
                            <span>@loadingMessage</span>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="mt-4">
                        <div class="h-2 w-full overflow-hidden rounded-full bg-gray-200">
                            <div class="h-full rounded-full bg-blue-600 transition-all duration-500" style="width: @(progress)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string abn = "";
    private string errorMessage = "";
    private bool isSearching = false;
    private string loadingMessage = "Connecting to ASIC database...";
    private int progress = 0;
    private Timer? loadingTimer;
    private Timer? progressTimer;
    private bool mobileMenuOpen = false;

    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;

    private readonly string[] loadingMessages = new[]
    {
        "Connecting to ASIC database...",
        "Verifying your ABN...",
        "Retrieving business names...",
        "Processing registration details...",
        "Finalizing results..."
    };

    private bool IsValidAbn()
    {
        var cleanAbn = abn.Replace(" ", "");
        return cleanAbn.Length == 11 && cleanAbn.All(char.IsDigit);
    }

    private async Task HandleSearch()
    {
        errorMessage = "";

        if (!IsValidAbn())
        {
            errorMessage = "Please enter a valid 11-digit ABN";
            return;
        }

        isSearching = true;
        progress = 0;
        var messageIndex = 0;

        loadingTimer = new Timer(_ =>
        {
            messageIndex = (messageIndex + 1) % loadingMessages.Length;
            loadingMessage = loadingMessages[messageIndex];
            InvokeAsync(StateHasChanged);
        }, null, 0, 4000);

        progressTimer = new Timer(_ =>
        {
            if (progress < 95)
            {
                progress += 5;
                InvokeAsync(StateHasChanged);
            }
        }, null, 0, 1000);

        var cleanAbn = abn.Replace(" ", "");

        // Get user info (declare outside try block for exception handler)
        var httpContext = HttpContextAccessor.HttpContext;
        var ipAddress = httpContext?.Connection?.RemoteIpAddress?.ToString();
        var userAgent = httpContext?.Request.Headers["User-Agent"].ToString();
        var sessionId = httpContext?.Session?.Id;

        try
        {
            var cacheKey = $"abn_search_{cleanAbn}";

            // Try to get from cache first
            BusinessNamesResult searchResult;
            if (!MemoryCache.TryGetValue(cacheKey, out searchResult))
            {
                // Not in cache, perform search using ASIC Renewal Service
                searchResult = await AsicRenewalClient.SearchByAbnAsync(cleanAbn);

                // Cache the result for 15 minutes
                var cacheOptions = new MemoryCacheEntryOptions()
                    .SetAbsoluteExpiration(TimeSpan.FromMinutes(15));

                MemoryCache.Set(cacheKey, searchResult, cacheOptions);
            }

            progress = 100;

            // Check if search failed
            if (!searchResult.Success)
            {
                // Log the failed search
                var failedSearchLog = new SearchLog
                {
                    Id = Guid.NewGuid(),
                    Abn = cleanAbn,
                    SearchedAt = DateTime.UtcNow,
                    IpAddress = ipAddress,
                    UserAgent = userAgent,
                    SessionId = sessionId,
                    Success = false,
                    InitiatedBy = SearchInitiator.Customer,
                    ErrorMessage = searchResult.ErrorMessage ?? "Search failed",
                    ResultsCount = 0
                };

                DbContext.SearchLogs.Add(failedSearchLog);
                await DbContext.SaveChangesAsync();

                // Show error message to user
                errorMessage = searchResult.ErrorMessage ?? "An error occurred while searching. Please try again.";
                isSearching = false;
                return;
            }

            // Create search log for successful search
            var searchLog = new SearchLog
            {
                Id = Guid.NewGuid(),
                Abn = cleanAbn,
                SearchedAt = DateTime.UtcNow,
                IpAddress = ipAddress,
                UserAgent = userAgent,
                SessionId = sessionId,
                Success = true,
                InitiatedBy = SearchInitiator.Customer,
                ErrorMessage = null,
                ResultsCount = searchResult.BusinessNames?.Count ?? 0
            };

            DbContext.SearchLogs.Add(searchLog);
            await DbContext.SaveChangesAsync();

            // Save each result
            if (searchResult.BusinessNames != null)
            {
                foreach (var business in searchResult.BusinessNames)
                {
                    var searchResultEntity = new Data.SearchResult
                    {
                        Id = Guid.NewGuid(),
                        SearchLogId = searchLog.Id,
                        BusinessName = business.Name,
                        AccountNumber = business.AccountNumber,
                        RegistrationDate = business.RegistrationDate
                    };

                    DbContext.SearchResults.Add(searchResultEntity);
                }
                await DbContext.SaveChangesAsync();
            }

            // Redirect to results page
            Navigation.NavigateTo($"/results/{searchLog.Id}");
        }
        catch (Exception ex)
        {
            // Log the exception as a failed search
            try
            {
                var exceptionSearchLog = new SearchLog
                {
                    Id = Guid.NewGuid(),
                    Abn = cleanAbn,
                    SearchedAt = DateTime.UtcNow,
                    IpAddress = ipAddress,
                    UserAgent = userAgent,
                    SessionId = sessionId,
                    Success = false,
                    InitiatedBy = SearchInitiator.Customer,
                    ErrorMessage = $"Exception: {ex.Message}",
                    ResultsCount = 0
                };

                DbContext.SearchLogs.Add(exceptionSearchLog);
                await DbContext.SaveChangesAsync();
            }
            catch
            {
                // Silently fail if we can't log - don't want to mask the original error
            }

            errorMessage = "An error occurred while searching. Please try again.";
            isSearching = false;
        }
        finally
        {
            loadingTimer?.Dispose();
            progressTimer?.Dispose();
        }
    }

    public void Dispose()
    {
        loadingTimer?.Dispose();
        progressTimer?.Dispose();
    }
}