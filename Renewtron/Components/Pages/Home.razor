@page "/"

@using Asic.Client
@using Asic.Client.Abstractions
@using Asic.Client.Models
@using Renewtron.Data
@using Microsoft.EntityFrameworkCore

@inject IAsicRegistrySearchClient AsicRegistrySearchClient
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Business Name Renewal - Renewtron</PageTitle>

<div class="min-h-screen bg-white">
    @if (!isSearching)
    {
        <!-- Landing Page - Tailwind UI Pro Style -->
        <div class="relative isolate overflow-hidden">
            <!-- Background Pattern -->
            <svg class="absolute inset-0 -z-10 h-full w-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]" aria-hidden="true">
                <defs>
                    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M.5 40V.5H40" fill="none" />
                    </pattern>
                </defs>
                <rect width="100%" height="100%" stroke-width="0" fill="url(#grid)" />
            </svg>

            <div class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:px-8 lg:py-20">
                <!-- Logo -->
                <div class="flex justify-center mb-8">
                    <div class="flex items-center gap-2">
                        <img src="/imgs/logo.svg" alt="Renewtron" class="h-10 w-auto" />
                        <span class="text-2xl font-semibold text-gray-900">Renewtron</span>
                    </div>
                </div>

                <div class="mx-auto max-w-2xl text-center">
                    <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl">
                        Renew your business name
                    </h1>
                    <p class="mt-6 text-lg leading-8 text-gray-600">
                        Complete your business name renewal in minutes. Enter your ABN to get started with our secure and streamlined process.
                    </p>
                </div>

                <!-- Search Card -->
                <div class="mx-auto mt-16 max-w-xl">
                    <form @onsubmit="HandleSearch" @onsubmit:preventDefault>
                        <div class="space-y-6">
                            <div>
                                <label for="abn" class="block text-sm font-medium leading-6 text-gray-900">
                                    Australian Business Number
                                </label>
                                <div class="mt-2">
                                    <input type="text"
                                           id="abn"
                                           @bind="abn"
                                           @bind:event="oninput"
                                           placeholder="12345678901"
                                           maxlength="14"
                                           class="block w-full rounded-md border-0 py-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 px-4"
                                           required />
                                </div>
                                @if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <p class="mt-2 text-sm text-red-600">@errorMessage</p>
                                }
                            </div>

                            <button type="submit"
                                    disabled="@(!IsValidAbn())"
                                    class="flex w-full justify-center rounded-md bg-indigo-600 px-3 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-indigo-600">
                                Search business names
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Features -->
                <div class="mt-16 grid grid-cols-1 gap-10 sm:grid-cols-3 text-center">
                    <div>
                        <div class="flex justify-center mb-3">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600">
                                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6
                                                 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623
                                                 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152
                                                 c-3.196 0-6.1-1.248-8.25-3.285z" />
                                </svg>
                            </div>
                        </div>
                        <h3 class="text-base font-semibold text-gray-900">Secure payment</h3>
                        <p class="mt-2 text-sm text-gray-600">Bank-level encryption protects your information</p>
                    </div>

                    <div>
                        <div class="flex justify-center mb-3">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600">
                                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75
                                                 12 13.5H3.75z" />
                                </svg>
                            </div>
                        </div>
                        <h3 class="text-base font-semibold text-gray-900">Instant processing</h3>
                        <p class="mt-2 text-sm text-gray-600">Complete your renewal in just a few minutes</p>
                    </div>

                    <div>
                        <div class="flex justify-center mb-3">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600">
                                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0
                                                 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                        </div>
                        <h3 class="text-base font-semibold text-gray-900">ASIC verified</h3>
                        <p class="mt-2 text-sm text-gray-600">Direct integration with official records</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Loading State - Tailwind UI Pro Style -->
        <div class="flex min-h-screen items-center justify-center px-6">
            <div class="w-full max-w-sm">
                <div class="text-center">
                    <!-- Spinner -->
                    <div class="mx-auto mb-8 flex h-16 w-16 items-center justify-center">
                        <svg class="h-16 w-16 animate-spin text-indigo-600" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>

                    <h2 class="text-lg font-semibold text-gray-900">Processing your request</h2>
                    <p class="mt-2 text-sm text-gray-600">This typically takes 20-25 seconds</p>

                    <!-- Warning Message -->
                    <div class="mt-4 rounded-md bg-yellow-50 p-3">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-yellow-800">Please do not close this page</p>
                                <p class="mt-1 text-xs text-yellow-700">Your search is in progress and will complete shortly</p>
                            </div>
                        </div>
                    </div>

                    <!-- Status Message -->
                    <div class="mt-8">
                        <div class="flex items-center justify-center gap-2 text-sm text-gray-600">
                            <div class="h-2 w-2 animate-pulse rounded-full bg-indigo-600"></div>
                            <span>@loadingMessage</span>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="mt-8">
                        <div class="h-2 w-full overflow-hidden rounded-full bg-gray-200">
                            <div class="h-full rounded-full bg-indigo-600 transition-all duration-500" style="width: @(progress)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string abn = "18184526648";
    private string errorMessage = "";
    private bool isSearching = false;
    private string loadingMessage = "Connecting to ASIC database...";
    private int progress = 0;
    private Timer? loadingTimer;
    private Timer? progressTimer;

    private readonly string[] loadingMessages = new[]
    {
        "Connecting to ASIC database...",
        "Verifying your ABN...",
        "Retrieving business names...",
        "Processing registration details...",
        "Finalizing results..."
    };

    private bool IsValidAbn()
    {
        var cleanAbn = abn.Replace(" ", "");
        return cleanAbn.Length == 11 && cleanAbn.All(char.IsDigit);
    }

    private async Task HandleSearch()
    {
        errorMessage = "";

        if (!IsValidAbn())
        {
            errorMessage = "Please enter a valid 11-digit ABN";
            return;
        }

        isSearching = true;
        progress = 0;
        var messageIndex = 0;

        loadingTimer = new Timer(_ =>
        {
            messageIndex = (messageIndex + 1) % loadingMessages.Length;
            loadingMessage = loadingMessages[messageIndex];
            InvokeAsync(StateHasChanged);
        }, null, 0, 4000);

        progressTimer = new Timer(_ =>
        {
            if (progress < 95)
            {
                progress += 5;
                InvokeAsync(StateHasChanged);
            }
        }, null, 0, 1000);

        try
        {
            var cleanAbn = abn.Replace(" ", "");

            // Get user info
            var httpContext = HttpContextAccessor.HttpContext;
            var ipAddress = httpContext?.Connection?.RemoteIpAddress?.ToString();
            var userAgent = httpContext?.Request.Headers["User-Agent"].ToString();
            var sessionId = httpContext?.Session?.Id;

            // Perform search
            var searchResult = await AsicRegistrySearchClient.SearchAsync(cleanAbn);
            progress = 100;

            // Create search log
            var searchLog = new SearchLog
            {
                Id = Guid.NewGuid(),
                Abn = cleanAbn,
                SearchedAt = DateTime.UtcNow,
                IpAddress = ipAddress,
                UserAgent = userAgent,
                SessionId = sessionId,
                Success = searchResult.Success,
                ErrorMessage = searchResult.Success ? null : "Search failed",
                ResultsCount = searchResult.Data?.BusinessNames?.Count ?? 0
            };

            DbContext.SearchLogs.Add(searchLog);
            await DbContext.SaveChangesAsync();

            // Save each result with holders
            if (searchResult.Success && searchResult.Data?.BusinessNames != null)
            {
                foreach (var business in searchResult.Data.BusinessNames)
                {
                    var searchResultEntity = new SearchResult
                    {
                        Id = Guid.NewGuid(),
                        SearchLogId = searchLog.Id,
                        BusinessName = business.Name,
                        Status = business.Status,
                        RegistrationDate = business.RegistrationDate,
                        RenewalDate = business.RenewalDate,
                        CancelledDate = business.CancelledDate,
                        CancellationUnderReview = business.CancellationUnderReview,
                        AddressForServiceDocuments = business.AddressForServiceDocuments,
                        PrincipalPlaceOfBusiness = business.PrincipalPlaceOfBusiness
                    };

                    DbContext.SearchResults.Add(searchResultEntity);
                    await DbContext.SaveChangesAsync();

                    // Add holders
                    if (business.Holders != null)
                    {
                        foreach (var holder in business.Holders)
                        {
                            DbContext.Holders.Add(new()
                            {
                                Id = Guid.NewGuid(),
                                SearchResultId = searchResultEntity.Id,
                                Name = holder.Name,
                                Type = holder.Type,
                                Abn = holder.Abn
                            });
                        }
                        await DbContext.SaveChangesAsync();
                    }
                }
            }

            // Redirect to results page
            Navigation.NavigateTo($"/results/{searchLog.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while searching. Please try again.";
            isSearching = false;
        }
        finally
        {
            loadingTimer?.Dispose();
            progressTimer?.Dispose();
        }
    }

    public void Dispose()
    {
        loadingTimer?.Dispose();
        progressTimer?.Dispose();
    }
}