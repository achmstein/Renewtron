@page "/renew-bulk"

@using Asic.Client.Models
@using Renewtron.Abstractions
@using Renewtron.Data
@using Renewtron.Services
@using Microsoft.EntityFrameworkCore
@using Asic.Client.Abstractions
@using Microsoft.Extensions.Options
@using Renewtron.Settings
@using Soenneker.Blazor.CreditCards
@using Hangfire

@inject ApplicationDbContext DbContext
@inject IEncryptionService EncryptionService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IStripePaymentService StripePaymentService
@inject IOptionsSnapshot<PricingSettings> PricingSettings
@inject IBackgroundJobClient BackgroundJobClient

<PageTitle>Bulk Renewal - Renewtron</PageTitle>

<div class="min-h-screen bg-gray-50">
    <!-- Logo -->
    <div class="flex justify-center pt-10 mb-8">
        <div class="flex items-center gap-2">
            <img src="/imgs/logo.svg" alt="Renewtron" class="h-10 w-auto" />
            <span class="text-2xl font-semibold text-gray-900">Renewtron</span>
        </div>
    </div>

    <div class="py-8 px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-4xl">
            @if (isLoading)
            {
                <div class="text-center">
                    <svg class="mx-auto h-12 w-12 animate-spin text-blue-600" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <p class="mt-4 text-sm text-gray-600">Loading...</p>
                </div>
            }
            else if (!searchResults.Any())
            {
                <div class="text-center">
                    <h3 class="text-lg font-semibold text-gray-900">No business names selected</h3>
                    <p class="mt-2 text-sm text-gray-600">Please go back and select the business names you want to renew.</p>
                    <a href="/" class="mt-4 inline-block text-blue-600 hover:text-blue-500">Back to Home</a>
                </div>
            }
            else if (isProcessing)
            {
                <div class="rounded-lg bg-white p-8 shadow text-center">
                    <svg class="mx-auto h-16 w-16 animate-spin text-blue-600" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <h3 class="mt-4 text-lg font-semibold text-gray-900">@processingStatus</h3>
                    <p class="mt-2 text-sm text-gray-600">Please wait while we process your requests...</p>

                    @if (processedCount > 0)
                    {
                        <div class="mt-4">
                            <div class="h-2 w-full overflow-hidden rounded-full bg-gray-200">
                                <div class="h-full rounded-full bg-blue-600 transition-all duration-500"
                                     style="width: @((processedCount * 100 / searchResults.Count))%"></div>
                            </div>
                            <p class="mt-2 text-xs text-gray-500">@processedCount of @searchResults.Count processed</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Header -->
                <div class="mb-8">
                    <h1 class="text-2xl font-bold text-gray-900">Bulk Renewal</h1>
                    <p class="mt-1 text-sm text-gray-600">
                        You're renewing @searchResults.Count business name@(searchResults.Count > 1 ? "s" : "")
                    </p>
                </div>

                <!-- Selected Business Names -->
                <div class="mb-8 overflow-hidden rounded-lg bg-white shadow">
                    <div class="bg-blue-600 px-6 py-4">
                        <h2 class="text-lg font-semibold text-white">Selected Business Names</h2>
                    </div>
                    <div class="divide-y divide-gray-200">
                        @foreach (var result in searchResults)
                        {
                            <div class="px-6 py-4">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <h3 class="font-medium text-gray-900">@result.BusinessName</h3>
                                        <p class="text-sm text-gray-500">Account: @result.AccountNumber</p>
                                    </div>
                                    <button @onclick="@(() => RemoveFromSelection(result.Id))"
                                            class="text-gray-400 hover:text-red-500">
                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Renewal Form -->
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <div class="px-6 py-6">
                        <h3 class="text-lg font-medium text-gray-900 mb-6">Renewal Details</h3>

                        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                            <!-- Renewal Period -->
                            <div class="mb-6">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Renewal Period (applies to all)</label>
                                <div class="grid grid-cols-2 gap-4">
                                    <div class="relative flex items-start">
                                        <div class="flex h-6 items-center">
                                            <input id="1year" name="renewalYears" type="radio" value="1" @onchange="@(() => renewalYears = 1)" checked="@(renewalYears == 1)"
                                                   class="h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-600">
                                        </div>
                                        <div class="ml-3">
                                            <label for="1year" class="text-sm font-medium text-gray-900">1 Year</label>
                                            <p class="text-sm text-gray-500">$@pricing.GetCustomerPrice(1).ToString("F2") each</p>
                                        </div>
                                    </div>
                                    <div class="relative flex items-start">
                                        <div class="flex h-6 items-center">
                                            <input id="3years" name="renewalYears" type="radio" value="3" @onchange="@(() => renewalYears = 3)" checked="@(renewalYears == 3)"
                                                   class="h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-600">
                                        </div>
                                        <div class="ml-3">
                                            <label for="3years" class="text-sm font-medium text-gray-900">3 Years</label>
                                            <p class="text-sm text-gray-500">$@pricing.GetCustomerPrice(3).ToString("F2") each</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Price Summary -->
                            <div class="mb-6 rounded-lg bg-gray-50 p-4">
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-600">@searchResults.Count business name@(searchResults.Count > 1 ? "s" : "") x $@pricing.GetCustomerPrice(renewalYears).ToString("F2")</span>
                                    <span class="font-medium text-gray-900">$@GetTotalPrice().ToString("F2")</span>
                                </div>
                                <div class="mt-2 flex justify-between border-t border-gray-200 pt-2">
                                    <span class="font-medium text-gray-900">Total</span>
                                    <span class="font-semibold text-blue-600">$@GetTotalPrice().ToString("F2")</span>
                                </div>
                            </div>

                            <!-- Credit Card Fields -->
                            <div class="mb-6">
                                <label class="block text-sm font-medium text-gray-700 mb-3">Payment Information</label>
                                <CreditCard @ref="creditCardComponent"
                                            CardNumber="@cardNumber"
                                            CardholderName="@cardHolder"
                                            ExpiryDate="@expiryDate"
                                            Cvc="@cvv" />
                                <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                                    <div>
                                        <label for="cardHolder" class="block text-sm font-medium text-gray-700">Cardholder Name</label>
                                        <input id="cardHolder" type="text" @bind="cardHolder" @bind:event="oninput" required placeholder="Name on card"
                                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-4 py-2 ring-1 ring-inset ring-gray-300" />
                                    </div>

                                    <div>
                                        <label for="cardNumber" class="block text-sm font-medium text-gray-700">Card Number</label>
                                        <input id="cardNumber" type="text" inputmode="numeric" maxlength="19" @bind="cardNumber" @oninput="FormatCardNumber" required placeholder="xxxx xxxx xxxx xxxx"
                                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-4 py-2 ring-1 ring-inset ring-gray-300" />
                                    </div>

                                    <div>
                                        <label for="expiryDate" class="block text-sm font-medium text-gray-700">Expiry (MM/YY)</label>
                                        <input id="expiryDate" type="text" maxlength="5" @bind="expiryDate" @oninput="FormatExpiryDate" required placeholder="MM/YY"
                                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-4 py-2 ring-1 ring-inset ring-gray-300" />
                                    </div>

                                    <div>
                                        <label for="cvv" class="block text-sm font-medium text-gray-700">CVC</label>
                                        <input id="cvv" type="password" maxlength="4" @bind="cvv" required placeholder="•••"
                                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-4 py-2 ring-1 ring-inset ring-gray-300" />
                                    </div>
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="mb-6">
                                <label for="email" class="block text-sm font-medium text-gray-700">Email Address</label>
                                <input type="email" id="email" @bind="email" required
                                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-4 py-2 ring-1 ring-inset ring-gray-300">
                                <p class="mt-1 text-xs text-gray-500">Receipts and confirmations will be sent to this email</p>
                            </div>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="mb-4 rounded-md bg-red-50 p-4">
                                    <div class="flex">
                                        <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                                        </svg>
                                        <div class="ml-3">
                                            <p class="text-sm text-red-800">@errorMessage</p>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Submit Button -->
                            <div class="flex items-center justify-between">
                                <button type="button" @onclick="GoBack" class="text-sm text-gray-600 hover:text-gray-900">
                                    ← Back to results
                                </button>
                                <button type="submit" disabled="@(!IsFormValid())"
                                        class="inline-flex items-center rounded-md bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-50 disabled:cursor-not-allowed">
                                    Process @searchResults.Count Renewal@(searchResults.Count > 1 ? "s" : "") - $@GetTotalPrice().ToString("F2")
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Security Notice -->
                <div class="mt-6 rounded-lg bg-blue-50 p-4">
                    <div class="flex">
                        <svg class="h-5 w-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                        <div class="ml-3">
                            <p class="text-sm text-blue-800">
                                <strong>Secure Payment:</strong> Your payment is processed securely via Stripe.
                                We'll handle the ASIC renewal on your behalf. Each business name renewal will be processed separately.
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    private bool isLoading = true;
    private bool isProcessing = false;
    private string processingStatus = "Processing payments...";
    private int processedCount = 0;
    private List<SearchResult> searchResults = new();
    private string errorMessage = "";
    private PricingSettings pricing = null!;
    private Guid? searchLogId;

    // Form fields
    private int renewalYears = 1;
    private string email = "";

    private CreditCard? creditCardComponent;
    private string cardNumber = "";
    private string cardHolder = "";
    private string expiryDate = "";
    private string cvv = "";

    protected override async Task OnInitializedAsync()
    {
        pricing = PricingSettings.Value;
        await LoadBusinessDetails();
    }

    private async Task LoadBusinessDetails()
    {
        isLoading = true;

        if (string.IsNullOrEmpty(Ids))
        {
            isLoading = false;
            return;
        }

        var idList = Ids.Split(',')
            .Where(s => Guid.TryParse(s, out _))
            .Select(Guid.Parse)
            .ToList();

        searchResults = await DbContext.SearchResults
            .Include(r => r.SearchLog)
            .Where(r => idList.Contains(r.Id))
            .ToListAsync();

        if (searchResults.Any())
        {
            searchLogId = searchResults.First().SearchLogId;
        }

        isLoading = false;
    }

    private decimal GetTotalPrice() => pricing.GetCustomerPrice(renewalYears) * searchResults.Count;

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(email) &&
               !string.IsNullOrWhiteSpace(cardNumber) &&
               !string.IsNullOrWhiteSpace(cardHolder) &&
               !string.IsNullOrWhiteSpace(expiryDate) &&
               !string.IsNullOrWhiteSpace(cvv) &&
               cardNumber.Replace(" ", "").Length >= 15 &&
               searchResults.Any();
    }

    private void RemoveFromSelection(Guid resultId)
    {
        searchResults = searchResults.Where(r => r.Id != resultId).ToList();
        if (!searchResults.Any() && searchLogId.HasValue)
        {
            Navigation.NavigateTo($"/results/{searchLogId}");
        }
    }

    private void GoBack()
    {
        if (searchLogId.HasValue)
        {
            Navigation.NavigateTo($"/results/{searchLogId}");
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = "";
        isProcessing = true;
        processedCount = 0;
        processingStatus = "Processing payment...";

        try
        {
            var httpContext = HttpContextAccessor.HttpContext;
            var ipAddress = httpContext?.Connection?.RemoteIpAddress?.ToString();
            var sessionId = httpContext?.Session?.Id;

            // Parse expiry date
            var expiryParts = expiryDate.Split('/');
            var expiryMonth = expiryParts[0];
            var expiryYear = "20" + expiryParts[1];

            var pricePerRenewal = pricing.GetCustomerPrice(renewalYears);
            var totalAmount = GetTotalPrice();

            // Step 1: Save customer's card (for display only)
            var customerCard = new SavedCreditCard
            {
                Id = Guid.NewGuid(),
                CardholderName = cardHolder,
                CardNumberLast4 = cardNumber.Replace(" ", "").Substring(cardNumber.Replace(" ", "").Length - 4),
                CardBrand = creditCardComponent?.Type,
                ExpiryMonth = expiryMonth,
                ExpiryYear = expiryYear,
                EncryptedCardNumber = EncryptionService.Encrypt(cardNumber.Replace(" ", "")),
                EncryptedCvc = EncryptionService.Encrypt(cvv),
                CreatedAt = DateTime.UtcNow,
                IpAddress = ipAddress,
                SessionId = sessionId
            };

            DbContext.SavedCreditCards.Add(customerCard);
            await DbContext.SaveChangesAsync();

            // Step 2: Process single payment for all renewals
            var businessNames = string.Join(", ", searchResults.Select(r => r.BusinessName));
            var metadata = new Dictionary<string, string>
            {
                { "renewal_count", searchResults.Count.ToString() },
                { "business_names", businessNames.Length > 500 ? businessNames.Substring(0, 500) : businessNames },
                { "renewal_years", renewalYears.ToString() }
            };

            var (paymentSuccess, paymentIntentId, paymentError) = await StripePaymentService.CreatePaymentIntentAsync(
                totalAmount,
                email,
                $"Business Name Renewal - {searchResults.Count} renewal(s)",
                metadata);

            if (!paymentSuccess)
            {
                errorMessage = $"Payment failed: {paymentError}";
                isProcessing = false;
                return;
            }

            // Step 3: Create renewal requests for each business name
            processingStatus = "Creating renewal requests...";
            StateHasChanged();

            var renewalRequestIds = new List<Guid>();

            foreach (var searchResult in searchResults)
            {
                processedCount++;

                // Check if renewal request already exists
                var renewalRequest = await DbContext.RenewalRequests
                    .FirstOrDefaultAsync(r => r.SearchResultId == searchResult.Id);

                if (renewalRequest != null)
                {
                    // Update existing
                    renewalRequest.RenewalYears = renewalYears;
                    renewalRequest.Email = email;
                    renewalRequest.PaymentType = PaymentType.Stripe;
                    renewalRequest.Amount = pricePerRenewal;
                    renewalRequest.ErrorMessage = null;
                    renewalRequest.FailedAtStep = null;
                    renewalRequest.Status = RenewalStatus.Pending;
                    renewalRequest.CompletedAt = null;
                    renewalRequest.TransactionReference = null;
                    renewalRequest.HostedTokenizationId = null;

                    if (renewalRequest.StripePayment != null)
                    {
                        DbContext.StripePayments.Remove(renewalRequest.StripePayment);
                    }
                }
                else
                {
                    // Create new
                    renewalRequest = new RenewalRequest
                    {
                        Id = Guid.NewGuid(),
                        SearchResultId = searchResult.Id,
                        InitiatedAt = DateTime.UtcNow,
                        RenewalYears = renewalYears,
                        Email = email,
                        PaymentType = PaymentType.Stripe,
                        Amount = pricePerRenewal,
                        Status = RenewalStatus.Pending
                    };
                    DbContext.RenewalRequests.Add(renewalRequest);
                }

                await DbContext.SaveChangesAsync();

                // Create Stripe payment record for each renewal
                var stripePayment = new StripePayment
                {
                    Id = Guid.NewGuid(),
                    RenewalRequestId = renewalRequest.Id,
                    CustomerCreditCardId = customerCard.Id,
                    PaymentIntentId = paymentIntentId!,
                    PaymentStatus = "succeeded",
                    PaidAt = DateTime.UtcNow
                };

                DbContext.StripePayments.Add(stripePayment);
                await DbContext.SaveChangesAsync();

                renewalRequestIds.Add(renewalRequest.Id);

                StateHasChanged();
            }

            // Step 4: Queue background jobs for each renewal
            processingStatus = "Scheduling renewal processing...";
            StateHasChanged();

            foreach (var renewalRequestId in renewalRequestIds)
            {
                BackgroundJobClient.Enqueue<IRenewalProcessingService>(service =>
                    service.ProcessRenewalAsync(renewalRequestId));
            }

            // Step 5: Redirect to bulk confirmation page
            var idsParam = string.Join(",", renewalRequestIds);
            Navigation.NavigateTo($"/renewal-confirmation-bulk?ids={idsParam}");
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            isProcessing = false;
        }
    }

    private void FormatCardNumber(ChangeEventArgs e)
    {
        var digits = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? Array.Empty<char>());
        cardNumber = string.Join(" ", Enumerable.Range(0, (digits.Length + 3) / 4)
                                                .Select(i => new string(digits.Skip(i * 4).Take(4).ToArray())))
                            .Trim();
    }

    private void FormatExpiryDate(ChangeEventArgs e)
    {
        var input = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? Array.Empty<char>());
        if (input.Length >= 3)
            expiryDate = input[..2] + "/" + input[2..Math.Min(4, input.Length)];
        else
            expiryDate = input;
    }
}
