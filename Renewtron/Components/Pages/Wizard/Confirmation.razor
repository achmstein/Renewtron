@page "/confirmation/{LeadId:guid}"

@using Renewtron.Data
@using Renewtron.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject ILeadService LeadService
@inject IJSRuntime JSRuntime

<PageTitle>Renewal Confirmation - Renewtron</PageTitle>

<div class="relative isolate overflow-auto flex-1">
    <!-- Background Pattern -->
    <svg class="absolute inset-0 -z-10 h-full w-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]" aria-hidden="true">
        <defs>
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M.5 40V.5H40" fill="none" />
            </pattern>
        </defs>
        <rect width="100%" height="100%" stroke-width="0" fill="url(#grid)" />
    </svg>

    <div class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:px-8 lg:py-12">
        @if (isLoading)
        {
            <div class="text-center py-12">
                <svg class="mx-auto h-12 w-12 animate-spin text-brand" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <p class="mt-4 text-sm text-gray-600">Loading...</p>
            </div>
        }
        else if (lead == null || !renewalRequests.Any())
        {
            <div class="text-center py-12">
                <h3 class="text-lg font-semibold text-gray-900">Confirmation not found</h3>
                <a href="/start" class="mt-4 inline-block text-brand hover:text-brand-dark">Start a new renewal</a>
            </div>
        }
        else
        {
            <!-- User Details Summary -->
            <div class="mx-auto max-w-2xl">
                <UserDetailsSummary Abn="@lead.Abn"
                                    FullName="@lead.FullName"
                                    Email="@lead.Email"
                                    MobileNumber="@lead.MobileNumber"
                                    DateOfBirth="@lead.DateOfBirth" />
            </div>

            <div class="mx-auto max-w-2xl">
                <!-- Success Header -->
                <div class="overflow-hidden rounded-xl bg-white shadow-lg ring-1 ring-gray-200">
                    @if (allCompleted)
                    {
                        <div class="bg-gradient-to-r from-green-600 to-green-500 px-6 py-8 text-center">
                            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-lg">
                                <svg class="h-10 w-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <h2 class="mt-4 text-2xl font-bold text-white">All Renewals Complete!</h2>
                            <p class="mt-2 text-sm text-green-100">
                                @renewalRequests.Count business name@(renewalRequests.Count > 1 ? "s have" : " has") been successfully renewed
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="bg-gradient-to-r from-blue-600 to-blue-500 px-6 py-8 text-center">
                            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-lg">
                                <svg class="h-10 w-10 text-brand" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <h2 class="mt-4 text-2xl font-bold text-white">Payment Successful!</h2>
                            <p class="mt-2 text-sm text-blue-100">
                                Your @renewalRequests.Count renewal@(renewalRequests.Count > 1 ? "s are" : " is") being processed
                            </p>
                        </div>
                    }

                    <!-- Summary Stats -->
                    <div class="px-6 py-5 border-b border-gray-100">
                        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                            <div class="text-center">
                                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Renewals</dt>
                                <dd class="mt-1 text-xl font-bold text-gray-900">@renewalRequests.Count</dd>
                            </div>
                            <div class="text-center">
                                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Period</dt>
                                <dd class="mt-1 text-xl font-bold text-gray-900">@(renewalRequests.FirstOrDefault()?.RenewalYears ?? 1) Yr</dd>
                            </div>
                            <div class="text-center">
                                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Completed</dt>
                                <dd class="mt-1 text-xl font-bold text-green-600">@completedCount</dd>
                            </div>
                            <div class="text-center">
                                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total</dt>
                                <dd class="mt-1 text-xl font-bold text-brand">$@totalAmount.ToString("F2")</dd>
                            </div>
                        </div>
                    </div>

                    <!-- Renewal List -->
                    <div class="divide-y divide-gray-100">
                        @foreach (var renewal in renewalRequests)
                        {
                            <div class="px-6 py-4">
                                <div class="flex items-center justify-between">
                                    <div class="flex-1 min-w-0">
                                        <h3 class="font-medium text-gray-900 truncate">@renewal.SearchResult?.BusinessName</h3>
                                        <p class="text-xs text-gray-500">Account: @renewal.SearchResult?.AccountNumber</p>
                                        @if (renewal.Status == RenewalStatus.Completed && !string.IsNullOrEmpty(renewal.TransactionReference))
                                        {
                                            <p class="mt-1 text-xs text-gray-500 font-mono">Ref: @renewal.TransactionReference</p>
                                        }
                                    </div>
                                    <div class="ml-4 flex items-center gap-3">
                                        <span class="text-sm font-medium text-gray-700">$@renewal.Amount.ToString("F2")</span>
                                        @if (renewal.Status == RenewalStatus.Completed)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                                                <svg class="mr-1 h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                                </svg>
                                                Done
                                            </span>
                                        }
                                        else if (renewal.Status == RenewalStatus.Failed)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-red-50 px-2.5 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">
                                                <svg class="mr-1 h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                                                </svg>
                                                Issue
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">
                                                <svg class="mr-1 h-3 w-3 animate-spin" fill="none" viewBox="0 0 24 24">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                                </svg>
                                                Processing
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Actions -->
                    <div class="bg-gray-50 px-6 py-4 flex items-center justify-between">
                        <a href="/start" class="text-sm font-medium text-brand hover:text-brand-dark">
                            Start another renewal
                        </a>
                        <button @onclick="PrintReceipt" class="inline-flex items-center gap-x-2 rounded-md bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5zm-3 0h.008v.008H15V10.5z" />
                            </svg>
                            Print
                        </button>
                    </div>
                </div>

                <!-- What's Next -->
                <div class="mt-6 rounded-xl bg-blue-50 border border-blue-100 p-5">
                    <h3 class="text-sm font-semibold text-blue-900">What happens next?</h3>
                    <ul class="mt-3 space-y-2 text-sm text-blue-800">
                        @if (allCompleted)
                        {
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                </svg>
                                <span class="ml-2">Confirmation emails sent to <strong>@lead.Email</strong></span>
                            </li>
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                </svg>
                                <span class="ml-2">Your business name registrations have been extended</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                </svg>
                                <span class="ml-2">Keep your transaction references for your records</span>
                            </li>
                        }
                        else
                        {
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                </svg>
                                <span class="ml-2">Payment of <strong>$@totalAmount.ToString("F2")</strong> processed successfully</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand animate-spin" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                                </svg>
                                <span class="ml-2">Renewals being processed with ASIC (takes a few minutes)</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z" />
                                    <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z" />
                                </svg>
                                <span class="ml-2">Confirmation emails will be sent to <strong>@lead.Email</strong></span>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Contact Support -->
                <div class="mt-6 text-center">
                    <p class="text-sm text-gray-500">
                        Questions? Contact us at
                        <a href="mailto:businessnames@applyforanabn.com.au" class="font-medium text-brand hover:text-brand-dark">
                            businessnames@applyforanabn.com.au
                        </a>
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid LeadId { get; set; }

    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    private Lead? lead;
    private List<RenewalRequest> renewalRequests = new();
    private bool isLoading = true;

    private bool allCompleted => renewalRequests.All(r => r.Status == RenewalStatus.Completed);
    private int completedCount => renewalRequests.Count(r => r.Status == RenewalStatus.Completed);
    private decimal totalAmount => renewalRequests.Sum(r => r.Amount);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        lead = await LeadService.GetLeadAsync(LeadId);

        if (lead == null)
        {
            isLoading = false;
            return;
        }

        if (!string.IsNullOrEmpty(Ids))
        {
            var idList = Ids.Split(',')
                .Where(s => Guid.TryParse(s, out _))
                .Select(Guid.Parse)
                .ToList();

            renewalRequests = await DbContext.RenewalRequests
                .Include(r => r.SearchResult)
                    .ThenInclude(sr => sr!.SearchLog)
                .Include(r => r.StripePayment)
                .Where(r => idList.Contains(r.Id))
                .ToListAsync();
        }

        isLoading = false;
    }

    private async Task PrintReceipt()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
