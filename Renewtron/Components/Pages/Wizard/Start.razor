@page "/start"

@inject NavigationManager Navigation

<PageTitle>Enter Your ABN - Renewtron</PageTitle>

<div class="relative isolate overflow-auto flex-1">
    <!-- Background Pattern -->
    <svg class="absolute inset-0 -z-10 h-full w-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]" aria-hidden="true">
        <defs>
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M.5 40V.5H40" fill="none" />
            </pattern>
        </defs>
        <rect width="100%" height="100%" stroke-width="0" fill="url(#grid)" />
    </svg>

    <div class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:px-8 lg:py-12">
        <!-- Wizard Progress -->
        <WizardProgress CurrentStep="1" Steps="@wizardSteps" AllowNavigation="false" />

        <div class="mx-auto max-w-2xl text-center">
            <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
                Renew your business name
            </h1>
            <p class="mt-4 text-lg leading-8 text-gray-600">
                Enter your ABN to get started with your business name renewal.
            </p>
        </div>

        <!-- ABN Entry Form -->
        <div class="mx-auto mt-12 max-w-md">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                <div class="space-y-6">
                    <div>
                        <label for="abn" class="block text-sm font-medium leading-6 text-gray-900">
                            Australian Business Number (ABN)
                        </label>
                        <div class="mt-2">
                            <input type="text"
                                   id="abn"
                                   @bind="abn"
                                   @bind:event="oninput"
                                   placeholder="12 345 678 901"
                                   maxlength="14"
                                   class="block w-full rounded-md border-0 py-3.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus-ring-brand sm:text-lg px-4 text-center tracking-wider"
                                   required />
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <p class="mt-2 text-sm text-red-600">@errorMessage</p>
                        }
                        <p class="mt-2 text-sm text-gray-500">
                            Your 11-digit Australian Business Number
                        </p>
                    </div>

                    <button type="submit"
                            disabled="@(!IsValidAbn())"
                            class="btn-primary flex w-full justify-center rounded-md px-4 py-3 text-sm font-semibold shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-colors">
                        Continue
                        <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@code {
    private string abn = "";
    private string errorMessage = "";

    private List<WizardProgress.WizardStep> wizardSteps = new()
    {
        new() { Label = "ABN" },
        new() { Label = "Details" },
        new() { Label = "Check" },
        new() { Label = "Select" },
        new() { Label = "Pay" }
    };

    private bool IsValidAbn()
    {
        var cleanAbn = abn.Replace(" ", "");
        return cleanAbn.Length == 11 && cleanAbn.All(char.IsDigit);
    }

    private void HandleSubmit()
    {
        errorMessage = "";

        if (!IsValidAbn())
        {
            errorMessage = "Please enter a valid 11-digit ABN";
            return;
        }

        var cleanAbn = abn.Replace(" ", "");
        Navigation.NavigateTo($"/details?abn={cleanAbn}");
    }
}
