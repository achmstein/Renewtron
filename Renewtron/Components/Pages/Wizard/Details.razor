@page "/details"

@using Renewtron.Services
@using Renewtron.Data

@inject NavigationManager Navigation
@inject ILeadService LeadService
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Your Details - Renewtron</PageTitle>

<div class="relative isolate overflow-auto flex-1">
    <!-- Background Pattern -->
    <svg class="absolute inset-0 -z-10 h-full w-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]" aria-hidden="true">
        <defs>
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M.5 40V.5H40" fill="none" />
            </pattern>
        </defs>
        <rect width="100%" height="100%" stroke-width="0" fill="url(#grid)" />
    </svg>

    <div class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:px-8 lg:py-12">
        <!-- Wizard Progress -->
        <WizardProgress CurrentStep="2" Steps="@wizardSteps" AllowNavigation="true" OnStepClick="HandleStepClick" />

        <div class="mx-auto max-w-2xl text-center">
            <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
                Tell us about yourself
            </h1>
            <p class="mt-3 text-base leading-7 text-gray-600">
                We'll use these details to process your renewal and keep you informed.
            </p>
        </div>

        <!-- ABN Badge -->
        <div class="mx-auto mt-6 max-w-md text-center">
            <span class="inline-flex items-center rounded-full bg-blue-100 px-4 py-2 text-sm font-medium text-blue-800">
                <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                ABN: @FormatAbn(abn)
            </span>
        </div>

        <!-- Details Form -->
        <div class="mx-auto mt-10 max-w-md">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                <div class="space-y-5">
                    <!-- Full Name -->
                    <div>
                        <label for="fullName" class="block text-sm font-medium leading-6 text-gray-900">
                            Full Name <span class="text-red-500">*</span>
                        </label>
                        <div class="mt-2">
                            <input type="text"
                                   id="fullName"
                                   @bind="fullName"
                                   @bind:event="oninput"
                                   placeholder="John Smith"
                                   class="@GetInputClasses(fullNameError)"
                                   required />
                        </div>
                        @if (!string.IsNullOrEmpty(fullNameError))
                        {
                            <p class="mt-1 text-sm text-red-600">@fullNameError</p>
                        }
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-sm font-medium leading-6 text-gray-900">
                            Email Address <span class="text-red-500">*</span>
                        </label>
                        <div class="mt-2">
                            <input type="email"
                                   id="email"
                                   @bind="email"
                                   @bind:event="oninput"
                                   placeholder="john@example.com"
                                   class="@GetInputClasses(emailError)"
                                   required />
                        </div>
                        @if (!string.IsNullOrEmpty(emailError))
                        {
                            <p class="mt-1 text-sm text-red-600">@emailError</p>
                        }
                        <p class="mt-1 text-xs text-gray-500">We'll send confirmation to this email</p>
                    </div>

                    <!-- Mobile Number -->
                    <div>
                        <label for="mobile" class="block text-sm font-medium leading-6 text-gray-900">
                            Mobile Number <span class="text-red-500">*</span>
                        </label>
                        <div class="mt-2">
                            <input type="tel"
                                   id="mobile"
                                   @bind="mobileNumber"
                                   @bind:event="oninput"
                                   placeholder="0412 345 678"
                                   maxlength="14"
                                   class="@GetInputClasses(mobileError)"
                                   required />
                        </div>
                        @if (!string.IsNullOrEmpty(mobileError))
                        {
                            <p class="mt-1 text-sm text-red-600">@mobileError</p>
                        }
                    </div>

                    <!-- Date of Birth -->
                    <div>
                        <label for="dob" class="block text-sm font-medium leading-6 text-gray-900">
                            Date of Birth <span class="text-red-500">*</span>
                        </label>
                        <div class="mt-2">
                            <input type="date"
                                   id="dob"
                                   @bind="dateOfBirth"
                                   max="@DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd")"
                                   class="@GetInputClasses(dobError)"
                                   required />
                        </div>
                        @if (!string.IsNullOrEmpty(dobError))
                        {
                            <p class="mt-1 text-sm text-red-600">@dobError</p>
                        }
                        <p class="mt-1 text-xs text-gray-500">You must be at least 18 years old</p>
                    </div>

                    @if (!string.IsNullOrEmpty(generalError))
                    {
                        <div class="rounded-md bg-red-50 p-4">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm text-red-800">@generalError</p>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Submit Button -->
                    <div class="pt-4">
                        <button type="submit"
                                disabled="@isSubmitting"
                                class="flex w-full justify-center rounded-md bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                            @if (isSubmitting)
                            {
                                <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Processing...</span>
                            }
                            else
                            {
                                <span>Check Renewal Status</span>
                                <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                </svg>
                            }
                        </button>
                    </div>

                    <!-- Back Link -->
                    <div class="text-center">
                        <button type="button" @onclick="GoBack" class="text-sm font-medium text-gray-600 hover:text-gray-500">
                            <svg class="inline-block mr-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                            </svg>
                            Back to ABN entry
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Abn { get; set; }

    private string abn = "";
    private string fullName = "";
    private string email = "";
    private string mobileNumber = "";
    private DateTime? dateOfBirth;

    private string fullNameError = "";
    private string emailError = "";
    private string mobileError = "";
    private string dobError = "";
    private string generalError = "";
    private bool isSubmitting = false;

    private List<WizardProgress.WizardStep> wizardSteps = new()
    {
        new() { Label = "ABN" },
        new() { Label = "Details" },
        new() { Label = "Check" },
        new() { Label = "Select" },
        new() { Label = "Pay" }
    };

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Abn))
        {
            Navigation.NavigateTo("/start");
            return;
        }
        abn = Abn;
    }

    private string FormatAbn(string abn)
    {
        if (string.IsNullOrEmpty(abn)) return "";
        var clean = abn.Replace(" ", "");
        if (clean.Length == 11)
        {
            return $"{clean[..2]} {clean[2..5]} {clean[5..8]} {clean[8..]}";
        }
        return abn;
    }

    private string GetInputClasses(string error)
    {
        var baseClasses = "block w-full rounded-md border-0 py-2.5 px-3 text-gray-900 shadow-sm ring-1 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset sm:text-sm";
        return string.IsNullOrEmpty(error)
            ? $"{baseClasses} ring-gray-300 focus:ring-blue-600"
            : $"{baseClasses} ring-red-300 focus:ring-red-500";
    }

    private void HandleStepClick(int step)
    {
        if (step == 1)
        {
            GoBack();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/start");
    }

    private bool ValidateForm()
    {
        bool isValid = true;
        fullNameError = "";
        emailError = "";
        mobileError = "";
        dobError = "";

        // Validate full name
        if (string.IsNullOrWhiteSpace(fullName))
        {
            fullNameError = "Please enter your full name";
            isValid = false;
        }
        else if (fullName.Trim().Length < 2)
        {
            fullNameError = "Name must be at least 2 characters";
            isValid = false;
        }

        // Validate email
        if (string.IsNullOrWhiteSpace(email))
        {
            emailError = "Please enter your email address";
            isValid = false;
        }
        else if (!IsValidEmail(email))
        {
            emailError = "Please enter a valid email address";
            isValid = false;
        }

        // Validate mobile
        var cleanMobile = mobileNumber.Replace(" ", "").Replace("-", "");
        if (string.IsNullOrWhiteSpace(cleanMobile))
        {
            mobileError = "Please enter your mobile number";
            isValid = false;
        }
        else if (cleanMobile.Length < 10)
        {
            mobileError = "Please enter a valid Australian mobile number";
            isValid = false;
        }

        // Validate DOB
        if (!dateOfBirth.HasValue)
        {
            dobError = "Please enter your date of birth";
            isValid = false;
        }
        else if (dateOfBirth.Value > DateTime.Now.AddYears(-18))
        {
            dobError = "You must be at least 18 years old";
            isValid = false;
        }

        return isValid;
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private async Task HandleSubmit()
    {
        generalError = "";

        if (!ValidateForm())
        {
            return;
        }

        isSubmitting = true;

        try
        {
            var httpContext = HttpContextAccessor.HttpContext;

            var dto = new CreateLeadDto
            {
                Abn = abn,
                FullName = fullName.Trim(),
                Email = email.Trim().ToLowerInvariant(),
                MobileNumber = mobileNumber.Replace(" ", "").Replace("-", ""),
                DateOfBirth = DateOnly.FromDateTime(dateOfBirth!.Value),
                IpAddress = httpContext?.Connection?.RemoteIpAddress?.ToString(),
                UserAgent = httpContext?.Request.Headers["User-Agent"].ToString(),
                SessionId = httpContext?.Session?.Id
            };

            var lead = await LeadService.CreateLeadAsync(dto);

            // Navigate to checking page
            Navigation.NavigateTo($"/checking/{lead.Id}");
        }
        catch (Exception ex)
        {
            generalError = "An error occurred. Please try again.";
            isSubmitting = false;
        }
    }
}
