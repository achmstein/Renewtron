@page "/results/{id:guid}"

@using Renewtron.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Search Results</PageTitle>

<div class="min-h-screen bg-white">
    <!-- Logo -->
    <div class="flex justify-center pt-10 mb-8">
        <div class="flex items-center gap-2">
            <img src="/imgs/logo.svg" alt="Renewtron" class="h-10 w-auto" />
            <span class="text-2xl font-semibold text-gray-900">Renewtron</span>
        </div>
    </div>
    @if (isLoading)
    {
        <div class="flex min-h-screen items-center justify-center">
            <div class="text-center">
                <svg class="mx-auto h-12 w-12 animate-spin text-indigo-600" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <p class="mt-4 text-sm text-gray-600">Loading results...</p>
            </div>
        </div>
    }
    else if (searchLog == null)
    {
        <div class="flex min-h-screen items-center justify-center">
            <div class="text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="mt-4 text-lg font-semibold text-gray-900">Search not found</h3>
                <p class="mt-2 text-sm text-gray-600">The search results you're looking for don't exist.</p>
                <div class="mt-6">
                    <a href="/" class="inline-flex items-center rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
                        Back to Home
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Results Page -->
        <div class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-gray-200 pb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Search results</h1>
                    <p class="mt-1 text-sm text-gray-600">ABN: @searchLog.Abn</p>
                    <p class="text-xs text-gray-500">Searched: @searchLog.SearchedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</p>
                </div>
                <a href="/"
                   class="inline-flex items-center gap-x-2 rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>
                    New search
                </a>
            </div>

            @if (searchLog.Results?.Any() == true)
            {
                <!-- Results List -->
                <div class="mt-8 space-y-6">
                    @foreach (var result in searchLog.Results)
                    {
                        <div class="overflow-hidden rounded-lg bg-white shadow ring-1 ring-black ring-opacity-5">
                            <div class="px-6 py-6">
                                <div class="flex items-start justify-between">
                                    <div class="flex-1">
                                        <h3 class="text-xl font-semibold text-gray-900">@result.BusinessName</h3>
                                        <div class="mt-2">
                                            <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset @GetStatusClass(result.Status)">
                                                @result.Status
                                            </span>
                                        </div>
                                    </div>
                                    <a href="/renew/@result.Id"
                                       class="ml-4 inline-flex items-center gap-x-2 rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                        Renew now
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                        </svg>
                                    </a>
                                </div>

                                <!-- Business Details -->
                                <dl class="mt-6 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
                                    @if (!string.IsNullOrEmpty(result.RegistrationDate))
                                    {
                                        <div>
                                            <dt class="text-sm font-medium text-gray-500">Registration date</dt>
                                            <dd class="mt-1 text-sm text-gray-900">@result.RegistrationDate</dd>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(result.RenewalDate))
                                    {
                                        <div>
                                            <dt class="text-sm font-medium text-gray-500">Renewal date</dt>
                                            <dd class="mt-1 text-sm text-gray-900">@result.RenewalDate</dd>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(result.CancelledDate))
                                    {
                                        <div>
                                            <dt class="text-sm font-medium text-gray-500">Cancelled date</dt>
                                            <dd class="mt-1 text-sm text-gray-900">@result.CancelledDate</dd>
                                        </div>
                                    }
                                </dl>

                                @if (result.Holders?.Any() == true)
                                {
                                    <div class="mt-6 border-t border-gray-200 pt-6">
                                        <h4 class="text-sm font-medium text-gray-900">Holders</h4>
                                        <ul role="list" class="mt-3 space-y-3">
                                            @foreach (var holder in result.Holders)
                                            {
                                                <li class="flex items-center justify-between rounded-md bg-gray-50 px-4 py-3">
                                                    <div>
                                                        <p class="text-sm font-medium text-gray-900">@holder.Name</p>
                                                        <p class="text-xs text-gray-500">@holder.Type</p>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(holder.Abn))
                                                    {
                                                        <p class="text-xs text-gray-500">ABN: @holder.Abn</p>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(result.AddressForServiceDocuments))
                                {
                                    <div class="mt-6 border-t border-gray-200 pt-6">
                                        <dt class="text-sm font-medium text-gray-900">Address for service</dt>
                                        <dd class="mt-2 text-sm text-gray-700">@result.AddressForServiceDocuments</dd>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(result.PrincipalPlaceOfBusiness))
                                {
                                    <div class="mt-6 border-t border-gray-200 pt-6">
                                        <dt class="text-sm font-medium text-gray-900">Principal place of business</dt>
                                        <dd class="mt-2 text-sm text-gray-700">@result.PrincipalPlaceOfBusiness</dd>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="mt-12 text-center">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <h3 class="mt-4 text-lg font-semibold text-gray-900">No business names found</h3>
                    <p class="mt-2 text-sm text-gray-600">We couldn't find any business names registered to this ABN.</p>
                    <div class="mt-6">
                        <a href="/"
                           class="inline-flex items-center rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                            Try another ABN
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool isLoading = true;
    private SearchLog? searchLog;

    protected override async Task OnInitializedAsync()
    {
        await LoadSearchResults();
    }

    private async Task LoadSearchResults()
    {
        isLoading = true;

        searchLog = await DbContext.SearchLogs
            .Include(s => s.Results)
                .ThenInclude(r => r.Holders)
            .FirstOrDefaultAsync(s => s.Id == Id);

        isLoading = false;
    }

    private string GetStatusClass(string status)
    {
        return status?.ToLower() switch
        {
            "registered" => "bg-green-50 text-green-700 ring-green-600/20",
            "active" => "bg-green-50 text-green-700 ring-green-600/20",
            "cancelled" => "bg-red-50 text-red-700 ring-red-600/20",
            "expired" => "bg-yellow-50 text-yellow-800 ring-yellow-600/20",
            _ => "bg-gray-50 text-gray-600 ring-gray-500/10"
        };
    }
}