@page "/renewal-confirmation"

@using Renewtron.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Renewal Confirmation - Renewtron</PageTitle>

<div class="py-8 px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl">
            @if (isLoading)
            {
                <div class="text-center">
                    <svg class="mx-auto h-12 w-12 animate-spin text-blue-600" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <p class="mt-4 text-sm text-gray-600">Loading...</p>
                </div>
            }
            else if (!renewalRequests.Any())
            {
                <div class="text-center">
                    <h3 class="text-lg font-semibold text-gray-900">Renewals not found</h3>
                    <a href="/" class="mt-4 inline-block text-blue-600 hover:text-blue-500">Back to Home</a>
                </div>
            }
            else
            {
                <!-- Success Header -->
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    @if (allCompleted)
                    {
                        <div class="bg-green-600 px-6 py-8 text-center">
                            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white">
                                <svg class="h-10 w-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <h2 class="mt-4 text-2xl font-bold text-white">All Renewals Successful!</h2>
                            <p class="mt-2 text-sm text-green-100">@renewalRequests.Count business name@(renewalRequests.Count > 1 ? "s have" : " has") been successfully renewed</p>
                        </div>
                    }
                    else
                    {
                        <div class="bg-blue-600 px-6 py-8 text-center">
                            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white">
                                <svg class="h-10 w-10 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <h2 class="mt-4 text-2xl font-bold text-white">Payment Confirmed!</h2>
                            <p class="mt-2 text-sm text-blue-100">Your @renewalRequests.Count renewal request@(renewalRequests.Count > 1 ? "s have" : " has") been placed</p>
                        </div>
                    }

                    <!-- Summary -->
                    <div class="px-6 py-6 border-b border-gray-200">
                        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                            <div class="text-center">
                                <dt class="text-sm font-medium text-gray-500">Total Renewals</dt>
                                <dd class="mt-1 text-2xl font-bold text-gray-900">@renewalRequests.Count</dd>
                            </div>
                            <div class="text-center">
                                <dt class="text-sm font-medium text-gray-500">Renewal Period</dt>
                                <dd class="mt-1 text-2xl font-bold text-gray-900">@(renewalRequests.FirstOrDefault()?.RenewalYears ?? 1) Year@(renewalRequests.FirstOrDefault()?.RenewalYears != 1 ? "s" : "")</dd>
                            </div>
                            <div class="text-center">
                                <dt class="text-sm font-medium text-gray-500">Completed</dt>
                                <dd class="mt-1 text-2xl font-bold text-green-600">@completedCount</dd>
                            </div>
                            <div class="text-center">
                                <dt class="text-sm font-medium text-gray-500">Total Paid</dt>
                                <dd class="mt-1 text-2xl font-bold text-blue-600">$@totalAmount.ToString("F2")</dd>
                            </div>
                        </div>
                    </div>

                    <!-- Renewal List -->
                    <div class="divide-y divide-gray-200">
                        @foreach (var renewal in renewalRequests)
                        {
                            <div class="px-6 py-4">
                                <div class="flex items-center justify-between">
                                    <div class="flex-1 min-w-0">
                                        <h3 class="font-medium text-gray-900 truncate">@renewal.SearchResult?.BusinessName</h3>
                                        <p class="text-sm text-gray-500">Account: @renewal.SearchResult?.AccountNumber</p>
                                    </div>
                                    <div class="ml-4 flex items-center gap-3">
                                        <span class="text-sm font-medium text-gray-900">$@renewal.Amount.ToString("F2")</span>
                                        @if (renewal.Status == RenewalStatus.Completed)
                                        {
                                            <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                                                <svg class="mr-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                                </svg>
                                                Completed
                                            </span>
                                        }
                                        else if (renewal.Status == RenewalStatus.Failed)
                                        {
                                            <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">
                                                <svg class="mr-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                                                </svg>
                                                Needs Attention
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-md bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-700 ring-1 ring-inset ring-yellow-600/20">
                                                <svg class="mr-1.5 h-2 w-2 animate-pulse fill-yellow-500" viewBox="0 0 6 6" aria-hidden="true">
                                                    <circle cx="3" cy="3" r="3" />
                                                </svg>
                                                Processing
                                            </span>
                                        }
                                    </div>
                                </div>
                                @if (renewal.Status == RenewalStatus.Completed && !string.IsNullOrEmpty(renewal.TransactionReference))
                                {
                                    <p class="mt-1 text-xs text-gray-500 font-mono">Ref: @renewal.TransactionReference</p>
                                }
                            </div>
                        }
                    </div>

                    <!-- Actions -->
                    <div class="bg-gray-50 px-6 py-4">
                        <div class="flex items-center justify-between">
                            <a href="/" class="text-sm font-medium text-blue-600 hover:text-blue-500">
                                ← Back to Home
                            </a>
                            <button @onclick="PrintReceipt" class="inline-flex items-center gap-x-2 rounded-md bg-white px-3.5 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5zm-3 0h.008v.008H15V10.5z" />
                                </svg>
                                Print Receipt
                            </button>
                        </div>
                    </div>
                </div>

                <!-- What's Next -->
                @if (allCompleted)
                {
                    <div class="mt-8 overflow-hidden rounded-lg bg-blue-50 p-6">
                        <h3 class="text-base font-semibold text-blue-900">What's Next?</h3>
                        <ul class="mt-3 space-y-2 text-sm text-blue-800">
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="ml-2">Confirmation emails have been sent to <strong>@(renewalRequests.FirstOrDefault()?.Email)</strong></span>
                            </li>
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="ml-2">All @renewalRequests.Count business name registrations have been extended</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="ml-2">Keep your transaction references for your records</span>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="mt-8 overflow-hidden rounded-lg bg-blue-50 p-6">
                        <h3 class="text-base font-semibold text-blue-900">What Happens Next?</h3>
                        <ul class="mt-3 space-y-2 text-sm text-blue-800">
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="ml-2">Your payment of <strong>$@totalAmount.ToString("F2")</strong> has been processed successfully</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-blue-600 animate-spin" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                                </svg>
                                <span class="ml-2">Our team is processing your @renewalRequests.Count renewal@(renewalRequests.Count > 1 ? "s" : "") with ASIC</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                                </svg>
                                <span class="ml-2">You will receive confirmation emails at <strong>@(renewalRequests.FirstOrDefault()?.Email)</strong> as each renewal completes</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.712 4.33a9.027 9.027 0 011.652 1.306c.51.51.944 1.064 1.306 1.652M16.712 4.33l-3.448 4.138m3.448-4.138a9.014 9.014 0 00-9.424 0M19.67 7.288l-4.138 3.448m4.138-3.448a9.014 9.014 0 010 9.424m-4.138-5.976a3.736 3.736 0 00-.88-1.388 3.737 3.737 0 00-1.388-.88m2.268 2.268a3.765 3.765 0 010 2.528m-2.268-4.796a3.765 3.765 0 00-2.528 0m4.796 4.796c-.181.506-.475.982-.88 1.388a3.736 3.736 0 01-1.388.88m2.268-2.268l4.138 3.448m0 0a9.027 9.027 0 01-1.306 1.652c-.51.51-1.064.944-1.652 1.306m0 0l-3.448-4.138m3.448 4.138a9.014 9.014 0 01-9.424 0m5.976-4.138a3.765 3.765 0 01-2.528 0m0 0a3.736 3.736 0 01-1.388-.88 3.737 3.737 0 01-.88-1.388m2.268 2.268L7.288 19.67m0 0a9.024 9.024 0 01-1.652-1.306 9.027 9.027 0 01-1.306-1.652m0 0l4.138-3.448M4.33 16.712a9.014 9.014 0 010-9.424m4.138 5.976a3.765 3.765 0 010-2.528m0 0c.181-.506.475-.982.88-1.388a3.736 3.736 0 011.388-.88m-2.268 2.268L4.33 7.288m6.406 1.18L7.288 4.33m0 0a9.024 9.024 0 00-1.652 1.306A9.025 9.025 0 004.33 7.288" />
                                </svg>
                                <span class="ml-2">If we encounter any issues, our team will handle it and contact you if needed</span>
                            </li>
                        </ul>
                    </div>
                }
            }
        </div>
    </div>

@code {
    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    private bool isLoading = true;
    private List<RenewalRequest> renewalRequests = new();
    private bool allCompleted => renewalRequests.All(r => r.Status == RenewalStatus.Completed);
    private int completedCount => renewalRequests.Count(r => r.Status == RenewalStatus.Completed);
    private decimal totalAmount => renewalRequests.Sum(r => r.Amount);

    protected override async Task OnInitializedAsync()
    {
        await LoadRenewalDetails();
    }

    private async Task LoadRenewalDetails()
    {
        isLoading = true;

        if (string.IsNullOrEmpty(Ids))
        {
            isLoading = false;
            return;
        }

        var idList = Ids.Split(',')
            .Where(s => Guid.TryParse(s, out _))
            .Select(Guid.Parse)
            .ToList();

        renewalRequests = await DbContext.RenewalRequests
            .Include(r => r.SearchResult)
                .ThenInclude(sr => sr!.SearchLog)
            .Include(r => r.StripePayment)
            .Where(r => idList.Contains(r.Id))
            .ToListAsync();

        isLoading = false;
    }

    private void PrintReceipt()
    {
        Navigation.NavigateTo($"javascript:window.print()", forceLoad: false);
    }
}
