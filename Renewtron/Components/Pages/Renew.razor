@page "/renew/{id:guid}"

@using Asic.Client.Models
@using Renewtron.Abstractions
@using Renewtron.Data
@using Renewtron.Services
@using Microsoft.EntityFrameworkCore
@using Asic.Client.Abstractions
@using Microsoft.Extensions.Options
@using Renewtron.Settings
@using Soenneker.Blazor.CreditCards

@inject ApplicationDbContext DbContext
@inject IEncryptionService EncryptionService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IAsicRenewalClient RenewalClient
@inject IStripePaymentService StripePaymentService
@inject IEmailService EmailService
@inject IOptionsSnapshot<AsicCreditCardSettings> AsicCardSettings
@inject IOptionsSnapshot<PricingSettings> PricingSettings

<PageTitle>Renew Business Name</PageTitle>

<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
        @if (isLoading)
        {
            <div class="text-center">
                <svg class="mx-auto h-12 w-12 animate-spin text-indigo-600" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <p class="mt-4 text-sm text-gray-600">Loading...</p>
            </div>
        }
        else if (searchResult == null)
        {
            <div class="text-center">
                <h3 class="text-lg font-semibold text-gray-900">Business not found</h3>
                <p class="mt-2 text-sm text-gray-600">The business you're trying to renew doesn't exist.</p>
                <a href="/" class="mt-4 inline-block text-indigo-600 hover:text-indigo-500">Back to Home</a>
            </div>
        }
        else if (isProcessing)
        {
            <div class="rounded-lg bg-white p-8 shadow text-center">
                <svg class="mx-auto h-16 w-16 animate-spin text-indigo-600" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <h3 class="mt-4 text-lg font-semibold text-gray-900">@processingStatus</h3>
                <p class="mt-2 text-sm text-gray-600">Please wait while we process your request...</p>
                <p class="mt-1 text-xs text-gray-500">This may take up to 2 minutes</p>
            </div>
        }
        else if (showSupportMessage)
        {
            <!-- Business Info Card -->
            <div class="mb-8 overflow-hidden rounded-lg bg-white shadow">
                <div class="bg-indigo-600 px-6 py-4">
                    <h2 class="text-xl font-semibold text-white">Renewal In Progress</h2>
                </div>
                <div class="px-6 py-4">
                    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Business Name</dt>
                            <dd class="mt-1 text-sm font-semibold text-gray-900">@searchResult.BusinessName</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Status</dt>
                            <dd class="mt-1">
                                <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset @GetStatusClass(searchResult.Status)">
                                    @searchResult.Status
                                </span>
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Current Renewal Date</dt>
                            <dd class="mt-1 text-sm text-gray-900">@searchResult.RenewalDate</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">ABN</dt>
                            <dd class="mt-1 text-sm text-gray-900">@searchResult.SearchLog?.Abn</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Customer Support Message -->
            <div class="rounded-lg bg-white shadow overflow-hidden">
                <div class="px-6 py-8">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <svg class="h-12 w-12 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                            </svg>
                        </div>
                        <div class="ml-4 flex-1">
                            <h3 class="text-lg font-semibold text-gray-900 mb-2">Our Customer Support Team is Working on Your Renewal</h3>
                            <div class="text-sm text-gray-700 space-y-3">
                                <p>Thank you for your payment. We received your payment successfully, but encountered an issue while processing your renewal with ASIC.</p>
                                <p><strong>Don't worry!</strong> Our customer support team has been notified and is actively working to complete your business name renewal.</p>
                                <div class="mt-4 bg-blue-50 rounded-md p-4 border border-blue-200">
                                    <div class="flex">
                                        <div class="flex-shrink-0">
                                            <svg class="h-5 w-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
                                            </svg>
                                        </div>
                                        <div class="ml-3">
                                            <h4 class="text-sm font-medium text-blue-800">Reference Number</h4>
                                            <p class="mt-1 text-sm text-blue-700 font-mono">@existingRenewalRequest.Id</p>
                                            <p class="mt-2 text-xs text-blue-600">Please keep this reference number for your records. You can use it to track the status of your renewal.</p>
                                        </div>
                                    </div>
                                </div>
                                <p class="mt-4">We'll send you an email confirmation at <strong>@existingRenewalRequest.Email</strong> once your renewal is completed.</p>
                                @if (!string.IsNullOrEmpty(existingRenewalRequest.ErrorMessage))
                                {
                                    <div class="mt-4 text-xs text-gray-500">
                                        <p class="font-medium">Technical details (for support reference):</p>
                                        <p class="mt-1">@existingRenewalRequest.ErrorMessage</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Back Link -->
            <div class="mt-6">
                <a href="/results/@searchResult.SearchLogId" class="text-sm text-indigo-600 hover:text-indigo-500">
                    ← Back to results
                </a>
            </div>
        }
        else
        {
            <!-- Business Info Card -->
            <div class="mb-8 overflow-hidden rounded-lg bg-white shadow">
                <div class="bg-indigo-600 px-6 py-4">
                    <h2 class="text-xl font-semibold text-white">Renew Business Name</h2>
                </div>
                <div class="px-6 py-4">
                    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Business Name</dt>
                            <dd class="mt-1 text-sm font-semibold text-gray-900">@searchResult.BusinessName</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Status</dt>
                            <dd class="mt-1">
                                <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset @GetStatusClass(searchResult.Status)">
                                    @searchResult.Status
                                </span>
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Current Renewal Date</dt>
                            <dd class="mt-1 text-sm text-gray-900">@searchResult.RenewalDate</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">ABN</dt>
                            <dd class="mt-1 text-sm text-gray-900">@searchResult.SearchLog?.Abn</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Renewal Form -->
            <div class="overflow-hidden rounded-lg bg-white shadow">
                <div class="px-6 py-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-6">Renewal Details</h3>

                    <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                        <!-- Renewal Period -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Renewal Period</label>
                            <div class="grid grid-cols-2 gap-4">
                                <div class="relative flex items-start">
                                    <div class="flex h-6 items-center">
                                        <input id="1year" name="renewalYears" type="radio" value="1" @onchange="@(() => renewalYears = 1)" checked="@(renewalYears == 1)"
                                               class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-600">
                                    </div>
                                    <div class="ml-3">
                                        <label for="1year" class="text-sm font-medium text-gray-900">1 Year</label>
                                        <p class="text-sm text-gray-500">$@pricing.GetCustomerPrice(1).ToString("F2")</p>
                                    </div>
                                </div>
                                <div class="relative flex items-start">
                                    <div class="flex h-6 items-center">
                                        <input id="3years" name="renewalYears" type="radio" value="3" @onchange="@(() => renewalYears = 3)" checked="@(renewalYears == 3)"
                                               class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-600">
                                    </div>
                                    <div class="ml-3">
                                        <label for="3years" class="text-sm font-medium text-gray-900">3 Years</label>
                                        <p class="text-sm text-gray-500">$@pricing.GetCustomerPrice(3).ToString("F2")</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="mb-6">
                            <label for="email" class="block text-sm font-medium text-gray-700">Email Address</label>
                            <input type="email" id="email" @bind="email" required
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2 ring-1 ring-inset ring-gray-300">
                            <p class="mt-1 text-xs text-gray-500">Receipt and confirmation will be sent to this email</p>
                        </div>

                        <!-- Credit Card Fields -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-700 mb-3">Payment Information</label>
                              <CreditCard @ref="creditCardComponent"
                                        CardNumber="@cardNumber"
                                        CardholderName="@cardHolder"
                                        ExpiryDate="@expiryDate"
                                        Cvc="@cvv" />
                            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                                <div>
                                    <label for="cardHolder" class="block text-sm font-medium text-gray-700">Cardholder Name</label>
                                    <input id="cardHolder" type="text" @bind="cardHolder" required placeholder="Name on card"
                                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2 ring-1 ring-inset ring-gray-300" />
                                </div>

                                <div>
                                    <label for="cardNumber" class="block text-sm font-medium text-gray-700">Card Number</label>
                                    <input id="cardNumber" type="text" inputmode="numeric" maxlength="19" @bind="cardNumber" @oninput="FormatCardNumber" required placeholder="xxxx xxxx xxxx xxxx"
                                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2 ring-1 ring-inset ring-gray-300" />
                                </div>

                                <div>
                                    <label for="expiryDate" class="block text-sm font-medium text-gray-700">Expiry (MM/YY)</label>
                                    <input id="expiryDate" type="text" maxlength="5" @bind="expiryDate" @oninput="FormatExpiryDate" required placeholder="MM/YY"
                                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2 ring-1 ring-inset ring-gray-300" />
                                </div>

                                <div>
                                    <label for="cvv" class="block text-sm font-medium text-gray-700">CVC</label>
                                    <input id="cvv" type="password" maxlength="4" @bind="cvv" required placeholder="•••"
                                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2 ring-1 ring-inset ring-gray-300" />
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="mb-4 rounded-md bg-red-50 p-4">
                                <div class="flex">
                                    <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                                    </svg>
                                    <div class="ml-3">
                                        <p class="text-sm text-red-800">@errorMessage</p>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Submit Button -->
                        <div class="flex items-center justify-between">
                            <a href="/results/@searchResult.SearchLogId" class="text-sm text-gray-600 hover:text-gray-900">
                                ← Back to results
                            </a>
                            <button type="submit" disabled="@(!IsFormValid())"
                                    class="inline-flex items-center rounded-md bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-50 disabled:cursor-not-allowed">
                                Process Renewal - $@pricing.GetCustomerPrice(renewalYears).ToString("F2")
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Security Notice -->
            <div class="mt-6 rounded-lg bg-blue-50 p-4">
                <div class="flex">
                    <svg class="h-5 w-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                    </svg>
                    <div class="ml-3">
                        <p class="text-sm text-blue-800">
                            <strong>Secure Payment:</strong> Your payment is processed securely via Stripe. 
                            We'll handle the ASIC renewal on your behalf.
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool isLoading = true;
    private bool isProcessing = false;
    private string processingStatus = "Processing payment...";
    private SearchResult? searchResult;
    private RenewalRequest? existingRenewalRequest;
    private bool showSupportMessage = false;
    private string errorMessage = "";
    private PricingSettings pricing;

    // Form fields
    private int renewalYears = 1;
    private string email = "";

    private CreditCard? creditCardComponent;
    private string cardNumber = "";
    private string cardHolder = "";
    private string expiryDate = "";
    private string cvv = "";

    protected override async Task OnInitializedAsync()
    {
        pricing = PricingSettings.Value;
        await LoadBusinessDetails();
    }

    private async Task LoadBusinessDetails()
    {
        isLoading = true;
        searchResult = await DbContext.SearchResults
            .Include(r => r.SearchLog)
            .Include(r => r.Holders)
            .FirstOrDefaultAsync(r => r.Id == Id);

        // Check if there's an existing renewal request for this search result
        // (1-to-1 relationship: each SearchResult has only one RenewalRequest)
        if (searchResult != null)
        {
            existingRenewalRequest = await DbContext.RenewalRequests
                .FirstOrDefaultAsync(r => r.SearchResultId == searchResult.Id);

            // Show support message if payment succeeded but ASIC renewal failed
            if (existingRenewalRequest != null &&
                existingRenewalRequest.StripePaymentStatus == "succeeded" &&
                !existingRenewalRequest.Completed)
            {
                showSupportMessage = true;
            }
        }

        isLoading = false;
    }

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(email) &&
               !string.IsNullOrWhiteSpace(cardNumber) &&
               !string.IsNullOrWhiteSpace(cardHolder) &&
               !string.IsNullOrWhiteSpace(expiryDate) &&
               !string.IsNullOrWhiteSpace(cvv) &&
               cardNumber.Replace(" ", "").Length >= 15;
    }

    private async Task HandleSubmit()
    {
        errorMessage = "";
        isProcessing = true;
        processingStatus = "Processing payment...";

        try
        {
            var httpContext = HttpContextAccessor.HttpContext;
            var ipAddress = httpContext?.Connection?.RemoteIpAddress?.ToString();
            var sessionId = httpContext?.Session?.Id;

            // Parse expiry date
            var expiryParts = expiryDate.Split('/');
            var expiryMonth = expiryParts[0];
            var expiryYear = "20" + expiryParts[1];

            var customerAmount = pricing.GetCustomerPrice(renewalYears);
            var asicAmount = pricing.GetAsicFee(renewalYears);

            // Step 1: Save customer's card (for display only)
            var customerCard = new SavedCreditCard
            {
                Id = Guid.NewGuid(),
                CardholderName = cardHolder,
                CardNumberLast4 = cardNumber.Replace(" ", "").Substring(cardNumber.Replace(" ", "").Length - 4),
                CardBrand = "Visa", // You can detect this
                ExpiryMonth = expiryMonth,
                ExpiryYear = expiryYear,
                EncryptedCardNumber = EncryptionService.Encrypt(cardNumber.Replace(" ", "")),
                EncryptedCvc = EncryptionService.Encrypt(cvv),
                CreatedAt = DateTime.UtcNow,
                IpAddress = ipAddress,
                SessionId = sessionId
            };

            DbContext.SavedCreditCards.Add(customerCard);
            await DbContext.SaveChangesAsync();

            // Step 2: Update existing renewal request or create new one
            var renewalRequest = await DbContext.RenewalRequests
                .FirstOrDefaultAsync(r => r.SearchResultId == searchResult!.Id);

            if (renewalRequest != null)
            {
                // Update existing renewal request (payment retry scenario)
                renewalRequest.CustomerCreditCardId = customerCard.Id;
                renewalRequest.RenewalYears = renewalYears;
                renewalRequest.Email = email;
                renewalRequest.CustomerAmount = customerAmount;
                renewalRequest.AsicAmount = asicAmount;
                renewalRequest.IpAddress = ipAddress;
                renewalRequest.SessionId = sessionId;
                // Clear previous error states
                renewalRequest.ErrorMessage = null;
                renewalRequest.FailedAtStep = null;
                renewalRequest.StripePaymentStatus = null;
                renewalRequest.StripePaymentIntentId = null;
                renewalRequest.StripePaidAt = null;
                renewalRequest.Completed = false;
                renewalRequest.CompletedAt = null;
                renewalRequest.TransactionReference = null;
                renewalRequest.HostedTokenizationId = null;
            }
            else
            {
                // Create new renewal request (first attempt)
                renewalRequest = new RenewalRequest
                {
                    Id = Guid.NewGuid(),
                    SearchResultId = searchResult!.Id,
                    CustomerCreditCardId = customerCard.Id,
                    InitiatedAt = DateTime.UtcNow,
                    IpAddress = ipAddress,
                    SessionId = sessionId,
                    RenewalYears = renewalYears,
                    Email = email,
                    CustomerAmount = customerAmount,
                    AsicAmount = asicAmount,
                    Completed = false
                };
                DbContext.RenewalRequests.Add(renewalRequest);
            }

            await DbContext.SaveChangesAsync();

            // Step 3: Process Stripe payment
            processingStatus = "Processing your payment...";
            StateHasChanged();

            var metadata = new Dictionary<string, string>
            {
                { "renewal_request_id", renewalRequest.Id.ToString() },
                { "business_name", searchResult.BusinessName },
                { "abn", searchResult.SearchLog.Abn },
                { "renewal_years", renewalYears.ToString() }
            };

            var (paymentSuccess, paymentIntentId, paymentError) = await StripePaymentService.CreatePaymentIntentAsync(
                customerAmount,
                email,
                $"Business Name Renewal - {searchResult.BusinessName}",
                metadata);

            if (!paymentSuccess)
            {
                renewalRequest.ErrorMessage = $"Stripe payment failed: {paymentError}";
                await DbContext.SaveChangesAsync();
                errorMessage = $"Payment failed: {paymentError}";
                isProcessing = false;
                return;
            }

            // Update renewal request with Stripe info
            renewalRequest.StripePaymentIntentId = paymentIntentId;
            renewalRequest.StripePaymentStatus = "succeeded";
            renewalRequest.StripePaidAt = DateTime.UtcNow;
            await DbContext.SaveChangesAsync();

            // Step 4: Process ASIC renewal using our credit card
            processingStatus = "Processing ASIC renewal...";
            StateHasChanged();

            var asicCard = AsicCardSettings.Value;
            var asicCardDetails = new CreditCardDetails
            {
                CardNumber = asicCard.CardNumber,
                CardholderName = asicCard.CardholderName,
                ExpiryMonth = asicCard.ExpiryMonth,
                ExpiryYear = asicCard.ExpiryYear,
                Cvc = asicCard.Cvc
            };

            var result = await RenewalClient.RenewBusinessNameAsync(
                searchResult.SearchLog!.Abn,
                searchResult.BusinessName,
                renewalYears,
                email,
                asicCardDetails
            );

            // Step 5: Update renewal request with ASIC result
            renewalRequest.Completed = result.IsSuccess;
            renewalRequest.CompletedAt = DateTime.UtcNow;
            renewalRequest.TransactionReference = result.TransactionReference;
            renewalRequest.HostedTokenizationId = result.HostedTokenizationId;
            renewalRequest.ErrorMessage = result.IsSuccess ? null : result.Message;
            renewalRequest.FailedAtStep = result.IsSuccess ? null : result.FailedAtStep;

            await DbContext.SaveChangesAsync();

            if (result.IsSuccess)
            {
                // Step 6: Send confirmation email
                processingStatus = "Sending confirmation email...";
                StateHasChanged();

                try
                {
                    await EmailService.SendRenewalConfirmationAsync(
                        email,
                        searchResult.BusinessName,
                        searchResult.SearchLog.Abn,
                        renewalYears,
                        customerAmount,
                        result.TransactionReference
                    );
                }
                catch (Exception emailEx)
                {
                    // Log email error but don't fail the transaction
                    Console.WriteLine($"Email send failed: {emailEx.Message}");
                }

                // Step 7: Redirect to success page
                Navigation.NavigateTo($"/renewal-success/{renewalRequest.Id}");
            }
            else
            {
                // ASIC renewal failed, but customer was already charged
                // You should handle refunds here
                errorMessage = $"Payment successful but ASIC renewal failed: {result.Message}. " +
                             $"Please contact support with reference: {renewalRequest.Id}";
                isProcessing = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            isProcessing = false;
        }
    }

    private void FormatCardNumber(ChangeEventArgs e)
    {
        var digits = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? Array.Empty<char>());
        cardNumber = string.Join(" ", Enumerable.Range(0, (digits.Length + 3) / 4)
                                                .Select(i => new string(digits.Skip(i * 4).Take(4).ToArray())))
                            .Trim();
    }

    private void FormatExpiryDate(ChangeEventArgs e)
    {
        var input = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? Array.Empty<char>());
        if (input.Length >= 3)
            expiryDate = input[..2] + "/" + input[2..Math.Min(4, input.Length)];
        else
            expiryDate = input;
    }

    private string GetStatusClass(string? status)
    {
        return status?.ToLower() switch
        {
            "registered" => "bg-green-50 text-green-700 ring-green-600/20",
            "active" => "bg-green-50 text-green-700 ring-green-600/20",
            "cancelled" => "bg-red-50 text-red-700 ring-red-600/20",
            "expired" => "bg-yellow-50 text-yellow-800 ring-yellow-600/20",
            _ => "bg-gray-50 text-gray-600 ring-gray-500/10"
        };
    }
}