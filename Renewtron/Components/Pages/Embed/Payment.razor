@page "/embed/payment/{LeadId:guid}"
@layout EmptyLayout

<PageTitle>Payment - Renewtron</PageTitle>

<PaymentContent RoutePrefix="/embed" LeadId="@LeadId" Ids="@Ids" Years="@Years" />

@code {
    [Parameter]
    public Guid LeadId { get; set; }

    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    [SupplyParameterFromQuery(Name = "years")]
    public int? Years { get; set; }
}
